---
/*
  Admin · Forgot password (Figma 352:2889). The API answers the same way
  whether or not the address matches, so this page never reveals which
  emails exist. The address is passed to "Check your email" in session
  storage, not in the page address.
*/
import AdminLayout from '../../layouts/AdminLayout.astro';
import FormField from '../../components/FormField.astro';
import Button from '../../components/Button.astro';
import TextLink from '../../components/TextLink.astro';
import { adminPaths } from '../../config/admin';
---

<AdminLayout title="Reset your password" variant="auth">
  <h1 class="t-h3">Reset your password</h1>
  <p class="t-body-small admin-auth__note">
    Enter the email address you use to sign in. We will email you a link to set a new password.
  </p>
  <form class="admin-form" novalidate data-forgot-form>
    <FormField name="email" label="Email address" type="email" placeholder="name@example.com" autocomplete="username" required />
    <p class="admin-alert" role="alert" data-forgot-error></p>
    <Button type="submit" class="admin-auth__submit" data-forgot-submit>Send Reset Link</Button>
  </form>
  <TextLink href={adminPaths.signIn}>Back to sign in</TextLink>
</AdminLayout>

<style>
  :global(.admin-auth__submit) {
    width: 100%;
  }
</style>

<script>
  import { api, ApiError } from '../../lib/api';
  import { adminPaths } from '../../config/admin';

  const form = document.querySelector<HTMLFormElement>('[data-forgot-form]')!;
  const input = form.elements.namedItem('email') as HTMLInputElement;
  const error = document.querySelector<HTMLElement>('[data-forgot-error]')!;
  const submit = form.querySelector<HTMLButtonElement>('[data-forgot-submit]')!;

  input.addEventListener('input', () => {
    input.removeAttribute('aria-invalid');
    form.querySelector('[data-error-for="email"]')!.textContent = '';
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    error.textContent = '';
    const email = input.value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      input.setAttribute('aria-invalid', 'true');
      form.querySelector('[data-error-for="email"]')!.textContent = 'Enter a valid email address.';
      input.focus();
      return;
    }
    submit.disabled = true;
    try {
      await api('/auth/forgot-password', { method: 'POST', body: JSON.stringify({ email }) });
      try {
        sessionStorage.setItem('omwi-reset-email', email);
      } catch {
        // Storage blocked: the next page uses general wording.
      }
      window.location.assign(adminPaths.checkEmail);
    } catch (err) {
      error.textContent = err instanceof ApiError ? err.message : 'Something went wrong. Please try again.';
      submit.disabled = false;
    }
  });
</script>
