---
/*
  Admin · Edit post (Figma 342:2254), opened with ?id= for a saved post or
  without it for a new one (Write a Blog Post).

  Title, web address, summary and the post's text with a formatting toolbar
  (heading, bold, italic, link, lists, quote). The text is saved in the
  limited format of lib/postText.ts. Side column: status and publish date
  (a later date schedules the post), category, featured image and its
  description. Save Draft keeps the post off the site; Publish puts it on
  the Blog page (the API needs a title and text for that). Preview shows
  the unsaved post in a new tab without saving it.

  Left for later (agreed 20 Oct 2026): the Search engines card and pictures
  inside the text (the toolbar's image button).
*/
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Button from '../../../components/Button.astro';
import FormField from '../../../components/FormField.astro';
import { adminPaths } from '../../../config/admin';
import arrowLeft from '../../../assets/icons/admin/arrow-left-plum.svg';
import heading from '../../../assets/icons/admin/tool-heading.svg';
import bold from '../../../assets/icons/admin/tool-bold.svg';
import italic from '../../../assets/icons/admin/tool-italic.svg';
import link from '../../../assets/icons/admin/tool-link.svg';
import bullets from '../../../assets/icons/admin/tool-bullets.svg';
import numbers from '../../../assets/icons/admin/tool-numbers.svg';
import quote from '../../../assets/icons/admin/tool-quote.svg';

const CATEGORIES = ['Maternal Health', 'Newborn Care', 'Menstrual Health', 'Mental Wellness', 'OMWI News'];
const tools = [
  { command: 'heading', label: 'Heading', icon: heading },
  { command: 'bold', label: 'Bold', icon: bold },
  { command: 'italic', label: 'Italic', icon: italic },
  { command: 'link', label: 'Link', icon: link },
  { command: 'bullets', label: 'Bulleted list', icon: bullets },
  { command: 'numbers', label: 'Numbered list', icon: numbers },
  { command: 'quote', label: 'Quote', icon: quote },
];
---

<AdminLayout title="Edit post" section="blog">
  <a class="admin-back t-button" href={adminPaths.blog}>
    <img src={arrowLeft.src} width="20" height="20" alt="" />
    All blog posts
  </a>

  <div class="admin-page-top">
    <div class="admin-page-header">
      <h1 class="t-h3">Edit post</h1>
      <p class="t-body-small" data-subtitle>&nbsp;</p>
    </div>
    <div class="admin-page-top__actions edit-actions">
      <Button variant="outline" data-preview>Preview</Button>
      <Button variant="secondary" data-save-draft>Save Draft</Button>
      <Button data-publish>Publish</Button>
    </div>
  </div>

  <p class="visually-hidden" aria-live="polite" data-status></p>

  <form class="admin-columns" method="post" novalidate hidden data-post-form>
    <div class="admin-columns__main">
      <section class="admin-card" aria-label="Post">
        <FormField name="title" label="Title" autocomplete="off" />
        <FormField
          name="slug"
          label="Web address"
          autocomplete="off"
          helper="Made from the title. Change it only before the post is published."
        />
        <FormField name="summary" label="Summary" type="textarea" helper="Shown on the Blog page and in search results." />
      </section>

      <section class="admin-card edit-content" aria-labelledby="content-label">
        <p class="t-button" id="content-label">Post content</p>
        <div class="edit-toolbar" role="toolbar" aria-label="Formatting" aria-controls="post-editor">
          {
            tools.map((tool) => (
              <button type="button" class="edit-tool" aria-pressed="false" data-tool={tool.command}>
                <img src={tool.icon.src} width="22" height="22" alt="" />
                <span class="visually-hidden">{tool.label}</span>
              </button>
            ))
          }
        </div>
        <div
          class="edit-editor t-body-large"
          id="post-editor"
          contenteditable="true"
          role="textbox"
          aria-multiline="true"
          aria-labelledby="content-label"
          data-placeholder="Keep writing here…"
          data-editor
        >
        </div>
      </section>
    </div>

    <div class="admin-columns__side">
      <section class="admin-card" aria-labelledby="publishing-title">
        <h2 class="t-h4" id="publishing-title">Publishing</h2>
        <div class="edit-status">
          <span class="t-body-small admin-muted">Status</span>
          <span data-badge></span>
        </div>
        <FormField name="publishAt" label="Publish date" type="date" helper="Pick a later date to schedule the post." />
      </section>

      <section class="admin-card" aria-labelledby="category-title">
        <h2 class="t-h4" id="category-title">Category</h2>
        <FormField
          name="category"
          label="Category"
          type="select"
          options={[{ value: '', label: 'No category' }, ...CATEGORIES.map((c) => ({ value: c, label: c }))]}
        />
      </section>

      <section class="admin-card" aria-labelledby="image-title">
        <h2 class="t-h4" id="image-title">Featured image</h2>
        <div class="edit-photo">
          <img alt="" hidden data-photo />
        </div>
        <input class="visually-hidden" type="file" accept="image/jpeg,image/png,image/webp" tabindex="-1" data-file />
        <Button variant="outline" class="edit-photo-button" data-choose-image>Change Image</Button>
        <FormField
          name="imageAlt"
          label="Image description"
          autocomplete="off"
          helper="Describe what the photo shows, for people who use screen readers."
        />
      </section>

      <button type="button" class="admin-danger t-button" hidden data-delete>Delete Post</button>
    </div>
  </form>
</AdminLayout>

<style>
  /* Phones: Preview, Save Draft, Publish from top to bottom (Figma) */
  .edit-actions {
    flex-direction: column;
    flex-wrap: wrap;
  }
  .edit-content {
    gap: var(--space-12);
  }
  .edit-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius-card);
    background: var(--bg-tint);
  }
  .edit-tool {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--size-icon-button);
    height: var(--size-icon-button);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-button);
    background: var(--bg-surface);
    cursor: pointer;
  }
  .edit-tool:hover,
  .edit-tool[aria-pressed='true'] {
    border-color: var(--border-primary);
    background: var(--bg-soft);
  }
  .edit-tool:focus-visible {
    outline: none;
    box-shadow: 0 0 0 var(--focus-ring-width) var(--focus-ring);
  }
  .edit-editor {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    min-height: var(--size-textarea-height);
    padding: var(--space-24);
    border: 1px solid var(--border-field);
    border-radius: var(--radius-button);
    background: var(--bg-field);
    color: var(--text-default);
    overflow-wrap: anywhere;
  }
  .edit-editor:focus-visible {
    outline: none;
    border-color: var(--border-primary);
    box-shadow: 0 0 0 var(--focus-ring-width) var(--focus-ring);
  }
  /* Sits over the empty first paragraph */
  .edit-editor[data-empty]::before {
    content: attr(data-placeholder);
    position: absolute;
    top: var(--space-24);
    left: var(--space-24);
    color: var(--text-muted);
    pointer-events: none;
  }
  .edit-editor :global(:is(p, ul, ol, blockquote, h2, div)) {
    margin: 0;
  }
  .edit-editor :global(h2) {
    font-size: var(--type-h4-size);
    font-weight: 600;
    line-height: var(--type-h4-line);
  }
  .edit-editor :global(:is(ul, ol)) {
    padding-left: var(--space-24);
  }
  .edit-editor :global(blockquote) {
    padding-left: var(--space-20);
    border-left: 3px solid var(--border-primary);
    font-style: italic;
  }
  .edit-editor :global(a) {
    color: var(--text-primary);
    text-decoration: underline;
  }
  .edit-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .edit-photo {
    position: relative;
    height: var(--size-admin-featured-photo);
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--photo-tint), var(--plum-400);
  }
  .edit-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .admin-columns__side .admin-danger {
    align-self: flex-start;
  }
  @media (min-width: 768px) {
    .edit-actions {
      flex-direction: row;
    }
    .edit-photo-button {
      align-self: flex-start;
    }
  }
</style>

<script>
  import { api, ApiError } from '../../../lib/api';
  import { adminPaths } from '../../../config/admin';
  import { requireAdmin, confirmAction, postBadge, badge, preparePhoto, type AdminPost } from '../../../lib/admin';
  import { renderPostText, postTextFrom, safeHref } from '../../../lib/postText';

  const form = document.querySelector<HTMLFormElement>('[data-post-form]')!;
  const editor = document.querySelector<HTMLElement>('[data-editor]')!;
  const field = <T extends HTMLElement = HTMLInputElement>(name: string) => form.elements.namedItem(name) as unknown as T;
  const title = field('title');
  const slug = field('slug');
  const summary = field<HTMLTextAreaElement>('summary');
  const publishAt = field('publishAt');
  const category = field<HTMLSelectElement>('category');
  const imageAlt = field('imageAlt');
  const photo = document.querySelector<HTMLImageElement>('[data-photo]')!;
  const fileInput = document.querySelector<HTMLInputElement>('[data-file]')!;
  const chooseImage = document.querySelector<HTMLButtonElement>('[data-choose-image]')!;
  const deleteButton = document.querySelector<HTMLButtonElement>('[data-delete]')!;
  const actions = [...document.querySelectorAll<HTMLButtonElement>('[data-preview], [data-save-draft], [data-publish]')];
  const subtitle = document.querySelector<HTMLElement>('[data-subtitle]')!;
  const statusEl = document.querySelector<HTMLElement>('[data-status]')!;
  const alertEl = document.querySelector<HTMLElement>('[data-admin-alert]')!;

  title.maxLength = 200;
  summary.maxLength = 300;
  imageAlt.maxLength = 250;

  let post: AdminPost | null = null;
  let imageFile: File | null = null;
  let unsaved = false;

  // Dates are days in Nigeria: a scheduled post goes live at the start of that day.
  const lagosDay = (value: string) => new Date(value).toLocaleDateString('en-CA', { timeZone: 'Africa/Lagos' });
  const startOfLagosDay = (day: string) => `${day}T00:00:00+01:00`;
  const time = (value: string) =>
    new Date(value).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Lagos' });

  const showBadge = (status: AdminPost['status'], at: string | null | undefined) => {
    const { label, tone } = postBadge({ status, publishAt: at });
    document.querySelector('[data-badge]')!.replaceChildren(badge(label, tone));
    return label;
  };

  // The text always sits in blocks: an empty editor gets one empty
  // paragraph, so the first line typed is a paragraph too.
  const markEmpty = () => {
    const empty = !editor.textContent?.trim() && !editor.querySelector('li');
    editor.toggleAttribute('data-empty', empty);
    if (empty && !editor.querySelector('p, h2, blockquote')) {
      const p = document.createElement('p');
      p.append(document.createElement('br'));
      editor.replaceChildren(p);
    }
  };

  const fill = (p: AdminPost) => {
    post = p;
    title.value = p.title;
    slug.value = p.slug ? `/blog/${p.slug}` : '';
    // The web address is fixed once the post has been published.
    slug.readOnly = Boolean(p.publishedAt);
    summary.value = p.summary;
    category.value = p.category;
    imageAlt.value = p.imageAlt;
    publishAt.value = p.publishAt ? lagosDay(p.publishAt) : '';
    editor.replaceChildren(renderPostText(p.description));
    markEmpty();
    photo.hidden = !p.images[0];
    if (p.images[0]) photo.src = p.images[0];
    chooseImage.textContent = p.images[0] ? 'Change Image' : 'Add Image';
    const label = showBadge(p.status, p.publishAt);
    subtitle.textContent = `${label} · last saved at ${time(p.updatedAt)}`;
    document.title = `${p.title || 'Untitled draft'} | OMWI website admin`;
    deleteButton.hidden = false;
    unsaved = false;
  };

  const startNew = () => {
    showBadge('draft', null);
    subtitle.textContent = 'Draft · not saved yet';
    chooseImage.textContent = 'Add Image';
    markEmpty();
  };

  const formData = (status: AdminPost['status']) => {
    const data = new FormData();
    data.set('status', status);
    data.set('title', title.value);
    data.set('slug', slug.value.trim().replace(/^\/?blog\//, ''));
    data.set('summary', summary.value);
    data.set('description', postTextFrom(editor));
    data.set('category', category.value);
    data.set('imageAlt', imageAlt.value);
    data.set('publishAt', publishAt.value ? startOfLagosDay(publishAt.value) : '');
    if (imageFile) data.set('image1', imageFile);
    return data;
  };

  const save = async (status: AdminPost['status']) => {
    alertEl.textContent = '';
    actions.forEach((b) => (b.disabled = true));
    try {
      const saved = post
        ? await api<AdminPost>(`/blogs/${encodeURIComponent(post._id)}`, { method: 'PUT', body: formData(status) })
        : await api<AdminPost>('/blogs', { method: 'POST', body: formData(status) });
      if (!post) history.replaceState(null, '', `?id=${encodeURIComponent(saved._id)}`);
      imageFile = null;
      fill(saved);
      statusEl.textContent = status === 'draft' ? 'Draft saved.' : `Post saved: ${showBadge(saved.status, saved.publishAt)}.`;
    } catch (error) {
      alertEl.textContent = error instanceof ApiError ? error.message : 'The post was not saved. Please try again.';
    } finally {
      actions.forEach((b) => (b.disabled = false));
    }
  };

  document.querySelector('[data-save-draft]')!.addEventListener('click', async () => {
    if (post && post.status === 'published') {
      const ok = await confirmAction({
        title: 'Move this post to drafts?',
        text: 'It will no longer show on the Blog page until you publish it again.',
        confirmLabel: 'Save Draft',
      });
      if (!ok) return;
    }
    save('draft');
  });
  document.querySelector('[data-publish]')!.addEventListener('click', () => save('published'));

  // Preview: the post as it is now, unsaved, on the public post page.
  document.querySelector('[data-preview]')!.addEventListener('click', () => {
    const now = new Date().toISOString();
    const preview = {
      _id: post?._id ?? 'preview',
      title: title.value.trim() || 'Untitled draft',
      description: postTextFrom(editor),
      summary: summary.value.trim(),
      category: category.value,
      images: post?.images ?? [],
      imageAlt: imageAlt.value.trim(),
      publishAt: publishAt.value ? startOfLagosDay(publishAt.value) : null,
      publishedAt: post?.publishedAt,
      createdAt: post?.createdAt ?? now,
      createdBy: post?.createdBy,
    };
    try {
      localStorage.setItem('omwi-post-preview', JSON.stringify(preview));
      window.open('/blog/post?preview=1', '_blank');
    } catch {
      alertEl.textContent = 'The preview could not open. Please allow this site to store data and try again.';
    }
  });

  deleteButton.addEventListener('click', async () => {
    if (!post) return;
    const ok = await confirmAction({
      title: 'Delete this post?',
      text: `"${post.title || 'Untitled draft'}" will be removed for good. This can't be undone.`,
      confirmLabel: 'Delete Post',
    });
    if (!ok) return;
    try {
      await api(`/blogs/${encodeURIComponent(post._id)}`, { method: 'DELETE' });
      unsaved = false;
      window.location.assign(adminPaths.blog);
    } catch (error) {
      alertEl.textContent = error instanceof ApiError ? error.message : 'The post was not deleted. Please try again.';
    }
  });

  // Featured image: chosen here, uploaded with the next save.
  chooseImage.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', async () => {
    const chosen = fileInput.files?.[0];
    fileInput.value = '';
    if (!chosen) return;
    const file = await preparePhoto(chosen);
    if (!file) {
      alertEl.textContent = 'Choose a JPEG, PNG or WebP photo.';
      return;
    }
    alertEl.textContent = '';
    imageFile = file;
    photo.src = URL.createObjectURL(file);
    photo.hidden = false;
    unsaved = true;
    statusEl.textContent = 'Photo chosen. It is uploaded when you save.';
  });

  // ----- Editor -----
  // execCommand is old but still the only built-in way to format inside an
  // editable area in every browser; what it produces is turned back into the
  // limited format on save, so stray markup never reaches the site.
  document.execCommand('defaultParagraphSeparator', false, 'p');
  document.execCommand('styleWithCSS', false, 'false');

  const closestInEditor = (selector: string) => {
    const node = window.getSelection()?.anchorNode;
    const element = node instanceof Element ? node : node?.parentElement;
    const found = element?.closest(selector);
    return found && editor.contains(found) ? found : null;
  };

  const addLink = () => {
    const selection = window.getSelection();
    if (!selection?.rangeCount || !editor.contains(selection.anchorNode)) return;
    const range = selection.getRangeAt(0);
    const existing = closestInEditor('a');
    let href = window.prompt('Link address', existing?.getAttribute('href') ?? 'https://')?.trim();
    if (href === undefined) return;
    if (!href || href === 'https://') {
      if (existing) document.execCommand('unlink');
      return;
    }
    if (/^www\./i.test(href)) href = `https://${href}`;
    if (!safeHref(href)) {
      alertEl.textContent = 'Links must start with https:// (or mailto: for an email address).';
      return;
    }
    if (selection.isCollapsed) {
      const a = document.createElement('a');
      a.href = href;
      a.textContent = href;
      range.insertNode(a);
      range.setStartAfter(a);
      selection.removeAllRanges();
      selection.addRange(range);
    } else {
      document.execCommand('createLink', false, href);
    }
  };

  const tools: Record<string, () => void> = {
    heading: () => document.execCommand('formatBlock', false, closestInEditor('h2') ? '<p>' : '<h2>'),
    bold: () => document.execCommand('bold'),
    italic: () => document.execCommand('italic'),
    link: addLink,
    bullets: () => document.execCommand('insertUnorderedList'),
    numbers: () => document.execCommand('insertOrderedList'),
    quote: () => document.execCommand('formatBlock', false, closestInEditor('blockquote') ? '<p>' : '<blockquote>'),
  };

  const toolButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-tool]')];
  const updateTools = () => {
    const state: Record<string, boolean> = {
      heading: Boolean(closestInEditor('h2')),
      bold: document.queryCommandState('bold'),
      italic: document.queryCommandState('italic'),
      link: Boolean(closestInEditor('a')),
      bullets: Boolean(closestInEditor('ul')),
      numbers: Boolean(closestInEditor('ol')),
      quote: Boolean(closestInEditor('blockquote')),
    };
    toolButtons.forEach((b) => b.setAttribute('aria-pressed', String(state[b.dataset.tool!] ?? false)));
  };

  toolButtons.forEach((button) => {
    // Keep the text selection in the editor while a tool is clicked.
    button.addEventListener('mousedown', (event) => event.preventDefault());
    button.addEventListener('click', () => {
      if (!editor.contains(window.getSelection()?.anchorNode ?? null)) editor.focus();
      tools[button.dataset.tool!]();
      unsaved = true;
      markEmpty();
      updateTools();
    });
  });

  // Pasted text arrives without its outside formatting.
  editor.addEventListener('paste', (event) => {
    event.preventDefault();
    document.execCommand('insertText', false, event.clipboardData?.getData('text/plain') ?? '');
  });
  editor.addEventListener('input', () => {
    unsaved = true;
    markEmpty();
  });
  document.addEventListener('selectionchange', () => {
    if (editor.contains(window.getSelection()?.anchorNode ?? null)) updateTools();
  });

  form.addEventListener('input', () => (unsaved = true));
  form.addEventListener('submit', (event) => event.preventDefault());
  window.addEventListener('beforeunload', (event) => {
    if (unsaved) event.preventDefault();
  });

  requireAdmin().then(async () => {
    const id = new URLSearchParams(window.location.search).get('id');
    try {
      if (id) fill((await api<{ post: AdminPost }>(`/admin/blogs/${encodeURIComponent(id)}`)).post);
      else startNew();
      form.hidden = false;
    } catch (error) {
      alertEl.textContent =
        error instanceof ApiError && error.status === 404
          ? 'We could not find that post. It may have been deleted.'
          : 'The post could not load. Please refresh the page.';
    }
  });
</script>
