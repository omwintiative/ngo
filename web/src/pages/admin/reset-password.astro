---
/*
  Admin · Set a new password (Figma 352:3181). Opened from the link in the
  reset email (?token=…). After saving, the admin goes to Sign in with a
  "Password updated" message. If the link has expired or was already used,
  the page says so and offers Send a new link (Figma note).
*/
import AdminLayout from '../../layouts/AdminLayout.astro';
import FormField from '../../components/FormField.astro';
import Button from '../../components/Button.astro';
import TextLink from '../../components/TextLink.astro';
import { adminPaths } from '../../config/admin';
---

<AdminLayout title="Set a new password" variant="auth">
  <h1 class="t-h3">Set a new password</h1>
  <p class="t-body-small admin-auth__note">Choose a new password for the OMWI admin account.</p>
  <form class="admin-form" method="post" novalidate data-reset-form>
    <FormField
      name="newPassword"
      label="New password"
      type="password"
      placeholder="Enter a new password"
      autocomplete="new-password"
      helper="Use a long password that you do not use anywhere else."
      required
    />
    <FormField
      name="confirmPassword"
      label="Confirm new password"
      type="password"
      placeholder="Enter the new password again"
      autocomplete="new-password"
      required
    />
    <p class="admin-alert" role="alert" data-reset-error></p>
    <Button type="submit" class="admin-auth__submit" data-reset-submit>Save New Password</Button>
  </form>
  <div hidden data-reset-expired>
    <TextLink href={adminPaths.forgotPassword}>Send a new link</TextLink>
  </div>
</AdminLayout>

<style>
  :global(.admin-auth__submit) {
    width: 100%;
  }
</style>

<script>
  import { api, ApiError } from '../../lib/api';
  import { adminPaths } from '../../config/admin';

  const MIN_LENGTH = 12; // same rule as the API (server/src/lib/passwords.js)
  const form = document.querySelector<HTMLFormElement>('[data-reset-form]')!;
  const error = document.querySelector<HTMLElement>('[data-reset-error]')!;
  const expired = document.querySelector<HTMLElement>('[data-reset-expired]')!;
  const submit = form.querySelector<HTMLButtonElement>('[data-reset-submit]')!;
  const token = new URLSearchParams(window.location.search).get('token') ?? '';

  const showExpired = (message: string) => {
    error.textContent = message;
    expired.hidden = false;
  };
  if (!/^[a-f0-9]{64}$/.test(token)) {
    showExpired('This link has expired or was already used. Ask for a new one.');
    submit.disabled = true;
  }

  const fieldError = (name: string, message: string) => {
    const input = form.elements.namedItem(name) as HTMLInputElement;
    input.setAttribute('aria-invalid', message ? 'true' : 'false');
    form.querySelector(`[data-error-for="${name}"]`)!.textContent = message;
  };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    error.textContent = '';
    const newPassword = (form.elements.namedItem('newPassword') as HTMLInputElement).value;
    const confirm = (form.elements.namedItem('confirmPassword') as HTMLInputElement).value;
    fieldError('newPassword', newPassword.length < MIN_LENGTH ? `Use at least ${MIN_LENGTH} characters.` : '');
    fieldError('confirmPassword', confirm !== newPassword ? 'The two passwords are not the same.' : '');
    const invalid = form.querySelector<HTMLElement>('[aria-invalid="true"]');
    if (invalid) {
      invalid.focus();
      return;
    }

    submit.disabled = true;
    try {
      await api('/auth/reset-password', { method: 'POST', body: JSON.stringify({ token, newPassword }) });
      try {
        sessionStorage.removeItem('omwi-reset-email');
      } catch {
        // nothing to clean up
      }
      window.location.assign(`${adminPaths.signIn}?updated=1`);
    } catch (err) {
      if (err instanceof ApiError && /expired|already used/i.test(err.message)) showExpired(err.message);
      else error.textContent = err instanceof ApiError ? err.message : 'Something went wrong. Please try again.';
      submit.disabled = false;
    }
  });
</script>
