---
/*
  Privacy Policy, from Figma (208:7806). Shows the Figma template
  (src/data/privacyPolicy.ts) until the admin saves OMWI's text in
  Admin · Privacy Policy; then that text (GET /api/pages/privacy-policy)
  replaces it, with its "Last updated" date. Kept out of search engines.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import banner from '../assets/photos/stock-banner-privacy.jpg';
import { intro, sections } from '../data/privacyPolicy';
---

<BaseLayout
  title="Privacy Policy"
  description="How the Ọmụgwọ Maternal Welfare Initiative collects, uses and protects your information."
  noindex
>
  <PageBanner title="Privacy Policy" crumbs={[{ label: 'Privacy Policy' }]} image={banner} imagePosition="center" />

  <section class="section policy-section" aria-label="Privacy policy">
    <article class="policy">
      <p class="t-body-small policy__updated" data-updated>Last updated: [date to be supplied by OMWI]</p>
      <div class="policy__body" data-policy-body>
        <p class="t-body-large">{intro}</p>
        {
          sections.map((s) => (
            <>
              <h2>{s.heading}</h2>
              <p class="t-body-large">{s.text}</p>
            </>
          ))
        }
      </div>
    </article>
  </section>
</BaseLayout>

<style>
  .policy-section {
    align-items: center;
  }
  .policy {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    width: 100%;
    max-width: var(--size-article-width);
  }
  .policy__updated {
    color: var(--text-muted);
  }
  .policy__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  /* The same look for the built-in text and the admin's text */
  .policy__body :global(h2) {
    font-size: var(--type-h3-size);
    font-weight: 700;
    line-height: var(--type-h3-line);
    letter-spacing: 0;
  }
  .policy__body :global(:is(p, li)) {
    font-size: var(--type-body-large-size);
    line-height: var(--type-body-large-line);
  }
  .policy__body :global(:is(ul, ol)) {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    margin: 0;
    padding-left: var(--space-24);
  }
  .policy__body :global(blockquote) {
    margin: 0;
    padding-left: var(--space-20);
    border-left: 3px solid var(--border-primary);
    font-style: italic;
  }
  .policy__body :global(a) {
    color: var(--text-primary);
    text-decoration: underline;
  }
</style>

<script>
  import { api } from '../lib/api';
  import { renderPostText } from '../lib/postText';

  api<{ body: string; updatedAt: string }>('/pages/privacy-policy')
    .then((page) => {
      document.querySelector('[data-policy-body]')!.replaceChildren(renderPostText(page.body));
      document.querySelector('[data-updated]')!.textContent = `Last updated: ${new Date(page.updatedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Africa/Lagos' })}`;
    })
    .catch(() => {
      // Not saved yet in the admin (or the API is unreachable): the template stays.
    });
</script>
