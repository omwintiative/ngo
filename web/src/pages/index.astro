---
/*
  Home, from Figma Home (Desktop 91:6522, Tablet 91:7024, Mobile 91:7517).
  The header sits over the hero, so the page needs no top padding.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/home/HeroSlider.astro';
import WhoWeAre from '../components/home/WhoWeAre.astro';
import WhatWeDo from '../components/home/WhatWeDo.astro';
import OurMission from '../components/home/OurMission.astro';
import FromTheField from '../components/home/FromTheField.astro';
import OurTeam from '../components/OurTeam.astro';
import Faq from '../components/Faq.astro';
import LatestPosts from '../components/home/LatestPosts.astro';
import DonationCallout from '../components/DonationCallout.astro';
import { paths, contact } from '../config/navigation';

// Who OMWI is, for search engines (schema.org NGO), from the footer details.
const organisation = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'Ọmụgwọ Maternal Welfare Initiative',
  alternateName: 'OMWI',
  url: Astro.site?.href,
  logo: Astro.site ? new URL('/apple-touch-icon.png', Astro.site).href : undefined,
  email: contact.email,
  telephone: contact.phone,
  address: { '@type': 'PostalAddress', addressLocality: 'Abuja', addressCountry: 'NG' },
};

// Home FAQ, exactly as in Figma (91:6838).
const faqs = [
  {
    q: 'What is OMWI?',
    a: 'The Ọmụgwọ Maternal Welfare Initiative exists to ensure that women, regardless of their socio-economic status and geographical location, have access to the reproductive healthcare and literacy that they need and deserve.',
  },
  {
    q: 'What does “ọmụgwọ” mean?',
    a: 'Ọmụgwọ is a traditional practice of the Igbo people in which a new mother is cared for in the early weeks after birth by her own mother or another woman in her family. That spirit of care is at the heart of our mission.',
  },
  {
    q: 'What programmes does OMWI run?',
    a: 'We facilitate programmes that promote maternal health literacy, newborn care, menstrual health literacy and access to period products, mental health and wellness, and access to primary reproductive healthcare through local care providers.',
  },
  {
    q: 'How can I volunteer?',
    a: 'Fill in the volunteer application form on our Join the Movement page. We offer a variety of volunteer roles.',
  },
  {
    q: 'How do I donate?',
    a: 'Go to the Donate page, choose an amount and pay securely online. Any donation, no matter how big or small, is deeply appreciated.',
  },
];
---

<BaseLayout
  title="Ọmụgwọ Maternal Welfare Initiative"
  description="OMWI promotes health equity and reproductive health dignity by expanding access to reproductive healthcare and education, wellness resources, and compassionate support."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(organisation)} />
  <HeroSlider />
  <WhoWeAre />
  <WhatWeDo />
  <OurMission />
  <FromTheField />
  <OurTeam />
  <Faq
    lead="Quick answers about who we are, what we do and how you can take part."
    items={faqs}
    link={{ label: 'Contact us', href: paths.contact }}
  />
  <LatestPosts />
  <DonationCallout />
</BaseLayout>
