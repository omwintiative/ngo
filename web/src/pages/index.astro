---
/*
  Home, from Figma Home (Desktop 91:6522, Tablet 91:7024, Mobile 91:7517).
  The header sits over the hero, so the page needs no top padding.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/home/HeroSlider.astro';
import WhoWeAre from '../components/home/WhoWeAre.astro';
import WhatWeDo from '../components/home/WhatWeDo.astro';
import OurMission from '../components/home/OurMission.astro';
import FromTheField from '../components/home/FromTheField.astro';
import OurTeam from '../components/OurTeam.astro';
import Faq from '../components/Faq.astro';
import LatestPosts from '../components/home/LatestPosts.astro';
import DonationCallout from '../components/DonationCallout.astro';
import { paths, contact } from '../config/navigation';

// Who OMWI is, for search engines (schema.org NGO), from the footer details.
const organisation = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'Ọmụgwọ Maternal Welfare Initiative',
  alternateName: 'OMWI',
  url: Astro.site?.href,
  logo: Astro.site ? new URL('/apple-touch-icon.png', Astro.site).href : undefined,
  email: contact.email,
  telephone: contact.phone,
  address: { '@type': 'PostalAddress', addressLocality: 'Abuja', addressCountry: 'NG' },
};
---

<BaseLayout
  title="Ọmụgwọ Maternal Welfare Initiative"
  description="OMWI promotes health equity and reproductive health dignity by expanding access to reproductive healthcare and education, wellness resources, and compassionate support."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(organisation)} />
  <HeroSlider />
  <WhoWeAre />
  <WhatWeDo />
  <OurMission />
  <FromTheField />
  <OurTeam />
  <Faq
    lead="Quick answers about who we are, what we do and how you can take part."
    page="home"
    link={{ label: 'Contact us', href: paths.contact }}
  />
  <LatestPosts />
  <DonationCallout />
</BaseLayout>
