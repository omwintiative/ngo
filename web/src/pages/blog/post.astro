---
/*
  One blog post, from Figma Blog post (Desktop 93:4661, Tablet 93:4843,
  Mobile 93:5017). Address: /blog/<web address> (vercel.json sends every
  such address to this page), or /blog/post?id=<id> for older posts.

  The post loads from GET /api/blogs/:idOrSlug in the browser, then the
  banner title, breadcrumb, page title and description update. The text is
  shown with its formatting (lib/postText.ts). "More from the blog" shows
  up to three other posts. If the post cannot be found, the 404 page's
  wording is shown.

  /blog/post?preview=1 shows the post the admin is editing, unsaved, from
  this browser's storage (Admin · Edit post, Preview).
*/
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import DonationCallout from '../../components/DonationCallout.astro';
import PostCardTemplate from '../../components/PostCardTemplate.astro';
import PostGrid from '../../components/PostGrid.astro';
import NotFoundMessage from '../../components/NotFoundMessage.astro';
import { paths } from '../../config/navigation';
import facebook from '../../assets/icons/facebook-plum.svg';
import whatsapp from '../../assets/icons/whatsapp-plum.svg';
import linkedin from '../../assets/icons/linkedin-plum.svg';

/*
  Share links (no SDKs, no tracking scripts). The script below fills in the
  page address, encoded. WhatsApp gets the title and the address as its
  message text (`withTitle`); Facebook and LinkedIn read the title from the
  page itself.
*/
const share = [
  { name: 'Facebook', icon: facebook, base: 'https://www.facebook.com/sharer/sharer.php?u=', withTitle: false },
  { name: 'WhatsApp', icon: whatsapp, base: 'https://wa.me/?text=', withTitle: true },
  { name: 'LinkedIn', icon: linkedin, base: 'https://www.linkedin.com/sharing/share-offsite/?url=', withTitle: false },
];
---

<BaseLayout title="Blog" description="An article from the Ọmụgwọ Maternal Welfare Initiative blog.">
  <PageBanner title="Blog" crumbs={[{ label: 'Blog', href: paths.blog }, { label: '' }]} />

  <section class="section article-section" aria-label="Article" data-post>
    <!-- Skeleton while the post loads: meta line, photo, paragraphs -->
    <div class="article" aria-hidden="true" data-skeleton data-post-skeleton>
      <span class="skeleton skeleton-text article__skeleton-meta"></span>
      <span class="skeleton article__photo"></span>
      {
        [0, 1].map(() => (
          <span class="article__skeleton-paragraph">
            <span class="skeleton skeleton-text article__skeleton-line" />
            <span class="skeleton skeleton-text article__skeleton-line" />
            <span class="skeleton skeleton-text article__skeleton-line" />
            <span class="skeleton skeleton-text article__skeleton-line article__skeleton-short" />
          </span>
        ))
      }
    </div>
    <article class="article" hidden data-post-article>
      <p class="t-body-small article__meta" data-post-meta></p>
      <div class="article__photo" hidden data-post-photo>
        <img alt="" data-post-photo-img />
        <span class="article__tint" aria-hidden="true"></span>
        <span class="article__fade" aria-hidden="true"></span>
      </div>
      <div class="article__body" data-post-body></div>
      <div class="share">
        <p class="t-button">Share this article</p>
        {
          share.map((s) => (
            <a
              class="share__button"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              data-share={s.base}
              data-share-title={s.withTitle ? '' : undefined}
            >
              <img src={s.icon.src} width="22" height="22" alt="" />
              <span class="visually-hidden">Share on {s.name} (opens in a new tab)</span>
            </a>
          ))
        }
      </div>
    </article>

    <NotFoundMessage hidden data-post-missing />
  </section>

  <section class="section section--tint" aria-labelledby="more-title" hidden data-more data-reveal>
    <h2 class="t-h2 more__title" id="more-title">More from the blog</h2>
    <PostGrid data-more-list />
    <PostCardTemplate />
  </section>

  <DonationCallout />
</BaseLayout>

<style>
  .article-section {
    align-items: center;
  }
  .article {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    width: 100%;
    max-width: var(--size-article-width);
  }
  .article__meta {
    color: var(--text-muted);
  }
  .article__photo {
    position: relative;
    height: var(--size-article-photo-height);
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--plum-400);
  }
  .article__photo img,
  .article__tint,
  .article__fade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .article__photo img {
    object-fit: cover;
  }
  .article__tint {
    background: var(--photo-tint);
    mix-blend-mode: soft-light;
  }
  .article__fade {
    background: linear-gradient(180deg, var(--photo-fade-color) 0%, transparent 72%);
  }
  .article__photo.skeleton {
    background: var(--bg-skeleton);
  }
  .article__skeleton-meta {
    width: 40%;
  }
  .article__skeleton-paragraph {
    display: flex;
    flex-direction: column;
  }
  .article__skeleton-line {
    --skeleton-size: var(--type-body-large-size);
    --skeleton-line: var(--type-body-large-line);
  }
  .article__skeleton-short {
    width: 60%;
  }
  .article__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }
  .article__body :global(:is(p, li)) {
    font-size: var(--type-body-large-size);
    line-height: var(--type-body-large-line);
  }
  .article__body :global(h2) {
    font-size: var(--type-h4-size);
    font-weight: 600;
    line-height: var(--type-h4-line);
  }
  .article__body :global(:is(ul, ol)) {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    margin: 0;
    padding-left: var(--space-24);
  }
  .article__body :global(blockquote) {
    margin: 0;
    padding-left: var(--space-20);
    border-left: 3px solid var(--border-primary);
    font-style: italic;
  }
  .article__body :global(a) {
    color: var(--text-primary);
    text-decoration: underline;
  }

  .share {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }
  .share__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--size-icon-button);
    height: var(--size-icon-button);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-button);
    background: var(--bg-surface);
  }
  .share__button:hover {
    background: var(--bg-soft);
  }

  .more__title {
    text-align: center;
  }

  @media (min-width: 768px) {
    .article__photo {
      height: var(--size-article-photo-height-tablet);
    }
  }
  @media (min-width: 1200px) {
    .article__photo {
      height: var(--size-article-photo-height-desktop);
    }
  }
</style>

<script>
  import { fetchPost, fetchPosts, formatDate, postAuthor, postDate, renderPostCard, safeImage, type Post } from '../../lib/posts';
  import { renderPostText } from '../../lib/postText';

  const params = new URLSearchParams(location.search);
  // /blog/<web address>, or ?id= for older links
  const fromPath = location.pathname.match(/^\/blog\/([a-z0-9-]+)\/?$/)?.[1];
  const key = fromPath && fromPath !== 'post' ? fromPath : params.get('id');
  const preview = params.has('preview');
  const article = document.querySelector<HTMLElement>('[data-post-article]')!;
  const skeleton = document.querySelector<HTMLElement>('[data-post-skeleton]')!;
  const missing = document.querySelector<HTMLElement>('[data-post-missing]')!;
  const title = document.querySelector<HTMLElement>('[data-banner-title]');
  const current = document.querySelector<HTMLElement>('[data-banner-current]');

  const showMissing = () => {
    skeleton.hidden = true;
    missing.hidden = false;
    if (title) title.textContent = 'Page Not Found';
    if (current) current.textContent = '404';
  };

  // Written by Admin · Edit post when its Preview button is pressed.
  const readPreview = (): Post | null => {
    try {
      return JSON.parse(localStorage.getItem('omwi-post-preview') ?? 'null');
    } catch {
      return null;
    }
  };

  const findPost = async (): Promise<Post | null> => {
    if (preview) return readPreview();
    if (!key) return null;
    try {
      return await fetchPost(key);
    } catch {
      return null;
    }
  };

  async function load() {
    const post = await findPost();
    if (!post) return showMissing();

    document.title = `${post.title} | Ọmụgwọ Maternal Welfare Initiative`;
    if (post.summary) document.querySelector('meta[name="description"]')?.setAttribute('content', post.summary);
    if (title) title.textContent = post.title;
    if (current) current.textContent = post.category ?? post.title;

    // Meta line: category · date · author (each only when known)
    const date = formatDate(postDate(post));
    const meta = [post.category, date?.text, postAuthor(post)].filter(Boolean).join('  ·  ');
    document.querySelector('[data-post-meta]')!.textContent = meta;

    const src = safeImage(post.images?.[0]);
    if (src) {
      const photo = document.querySelector<HTMLElement>('[data-post-photo]')!;
      const img = photo.querySelector('img')!;
      img.src = src;
      img.alt = post.imageAlt ?? '';
      photo.hidden = false;
    }

    document.querySelector<HTMLElement>('[data-post-body]')!.replaceChildren(renderPostText(post.description));

    const url = location.href;
    document.querySelectorAll<HTMLAnchorElement>('[data-share]').forEach((a) => {
      const value = 'shareTitle' in a.dataset ? `${post.title} ${url}` : url;
      a.href = `${a.dataset.share}${encodeURIComponent(value)}`;
    });

    skeleton.hidden = true;
    article.hidden = false;

    try {
      const others = (await fetchPosts()).filter((p) => p._id !== post._id).slice(0, 3);
      if (others.length) {
        document.querySelector('[data-more-list]')!.append(...others.map(renderPostCard));
        document.querySelector<HTMLElement>('[data-more]')!.hidden = false;
      }
    } catch {
      // No related posts: the section stays hidden
    }
  }

  load();
</script>
