---
/*
  Gallery, from Figma Gallery (Desktop 93:3395, Tablet 93:3592,
  Mobile 93:3782). Photos: the admin Gallery (GET /api/gallery), with the
  built-in ones in src/data/gallery.ts shown until they load, or if they
  cannot.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import GalleryGrid from '../components/gallery/GalleryGrid.astro';
import DonationCallout from '../components/DonationCallout.astro';
---

<BaseLayout
  title="Gallery"
  description="Photos of mothers, babies and volunteers at OMWI outreaches."
>
  <PageBanner title="Gallery" crumbs={[{ label: 'Gallery' }]} />
  <GalleryGrid />
  <DonationCallout />
</BaseLayout>
