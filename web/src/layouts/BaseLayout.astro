---
/*
  Every page uses this layout. It sets up the document head (title,
  description, social preview), loads the font and base styles, and gives
  each page a skip link, the site header, a <main> landmark and the footer.

  The header is fixed and sits over the top of the page (Figma puts it over
  the hero or page banner). A page without either should leave room for it:
  `padding-top: var(--layout-header-height)`.
*/
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '@fontsource-variable/montserrat';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/typography.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageLoader from '../components/PageLoader.astro';
import defaultShareImage from '../assets/photos/outreach-2.jpg';

interface Props {
  /** Page title, shown in the browser tab and search results. */
  title: string;
  /** One or two sentences for search results and link previews. */
  description: string;
  /** Keep this page out of search engines (for example, thank-you pages). */
  noindex?: boolean;
  /** Picture shown when the page is shared (WhatsApp, Facebook, LinkedIn). */
  shareImage?: ImageMetadata;
}

const { title, description, noindex = false, shareImage = defaultShareImage } = Astro.props;
const siteName = 'Ọmụgwọ Maternal Welfare Initiative';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
// Becomes an absolute URL once `site` is set in astro.config.mjs.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// 1200 x 630, the size link previews use.
const share = await getImage({ src: shareImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const shareUrl = Astro.site ? new URL(share.src, Astro.site).href : share.src;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The OMWI emblem (Figma Logo/Mark 36:65), in public/ -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <!-- Marks that JavaScript runs, so scroll reveals start hidden only then -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <PageLoader />
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />

    <script>
      // Scroll reveal: [data-reveal] elements fade up once as they come into
      // view. [data-count-to] numbers count up from 0 at the same moment
      // (Figma Our mission). Reduced motion: the same, but sections only fade
      // (no rise); see global.css.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal], [data-count-to]');

      const countUp = (el: HTMLElement) => {
        const target = Number(el.dataset.countTo);
        const suffix = el.dataset.countSuffix ?? '';
        const start = performance.now();
        const step = (now: number) => {
          const t = Math.min((now - start) / 1200, 1);
          const eased = 1 - (1 - t) ** 3;
          el.textContent = `${Math.round(target * eased).toLocaleString('en-GB')}${t === 1 ? suffix : ''}`;
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };

      if (!('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              el.classList.add('is-visible');
              if (el.dataset.countTo) countUp(el);
              observer.unobserve(el);
            });
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        items.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
