---
/*
  Form field, from Figma Input (45:187): label, field (Text or Textarea)
  an optional helper line, and an error line (Type=Error: red 2px border,
  red message). The error shows when the form script sets
  `aria-invalid="true"` on the field and fills the error line.
*/
import caret from '../assets/icons/admin/caret-down-plum-20.svg';

interface Props {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'password' | 'date' | 'textarea' | 'select';
  /** For type="select": the choices, in order. */
  options?: { value: string; label: string }[];
  placeholder?: string;
  autocomplete?: string;
  /** Keyboard on phones, e.g. "numeric" for amounts. */
  inputmode?: 'text' | 'numeric' | 'decimal' | 'tel' | 'email';
  required?: boolean;
  /** Muted line under the field (Figma "Helper"). */
  helper?: string;
  class?: string;
}

const {
  name,
  label,
  type = 'text',
  placeholder,
  autocomplete,
  inputmode,
  required = false,
  helper,
  options = [],
  class: className,
} = Astro.props;
const id = `field-${name}`;
const describedBy = [helper && `${id}-helper`, `${id}-error`].filter(Boolean).join(' ');
---

<div class:list={['field', className]}>
  <label class="t-button field__label" for={id}>{label}</label>
  {
    type === 'select' ? (
      <select
        class="t-body field__control field__control--select"
        style={`--select-caret: url("${caret.src}")`}
        id={id}
        name={name}
        aria-describedby={describedBy}
        aria-required={required ? 'true' : undefined}
      >
        {options.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))}
      </select>
    ) : type === 'textarea' ? (
      <textarea
        class="t-body field__control field__control--area"
        id={id}
        name={name}
        placeholder={placeholder}
        aria-describedby={describedBy}
        aria-required={required ? 'true' : undefined}
      />
    ) : (
      <input
        class="t-body field__control"
        id={id}
        name={name}
        type={type}
        placeholder={placeholder}
        autocomplete={autocomplete}
        inputmode={inputmode}
        aria-describedby={describedBy}
        aria-required={required ? 'true' : undefined}
      />
    )
  }
  {helper && <p class="t-body-small field__helper" id={`${id}-helper`}>{helper}</p>}
  <p class="t-body-small field__error" id={`${id}-error`} data-error-for={name}></p>
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    min-width: 0;
  }
  .field__label {
    color: var(--text-default);
  }
  .field__control {
    width: 100%;
    height: var(--size-button-height);
    padding: 0 var(--space-16);
    border: 1px solid var(--border-field);
    border-radius: var(--radius-button);
    background: var(--bg-field);
    color: var(--text-default);
  }
  .field__control--area {
    height: var(--size-textarea-height);
    padding: var(--space-14) var(--space-16);
    resize: vertical;
  }
  /* Figma Input, Type=Select: caret on the right */
  .field__control--select {
    padding-right: calc(var(--space-16) * 2 + var(--size-select-caret));
    background: var(--bg-field) var(--select-caret) no-repeat right var(--space-16) center / var(--size-select-caret);
    appearance: none;
  }
  .field__control::placeholder {
    color: var(--text-muted);
  }
  /* Not in Figma: focus uses the plum border and ring of the buttons */
  .field__control:focus-visible {
    outline: none;
    border-color: var(--border-primary);
    box-shadow: 0 0 0 var(--focus-ring-width) var(--focus-ring);
  }
  .field__control[aria-invalid='true'] {
    border: var(--border-width-error) solid var(--border-error);
    padding-inline: calc(var(--space-16) - 1px);
  }
  .field__helper {
    color: var(--text-muted);
  }
  .field__error {
    color: var(--text-error);
  }
  .field__error:empty {
    display: none;
  }
</style>
