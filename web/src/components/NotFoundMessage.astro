---
/*
  "We could not find that page." card, from Figma 404 Page not found
  (Section / Message, 128:7211). Used by the 404 page and by a blog post
  that does not exist.
*/
import MessageCard from './MessageCard.astro';
import Button from './Button.astro';
import { paths } from '../config/navigation';
import search from '../assets/icons/search-plum.svg';

interface Props {
  class?: string;
  [attr: string]: unknown;
}

const props = Astro.props;
---

<MessageCard
  icon={search}
  title="We could not find that page."
  text="The link may be old, or the page may have moved. Go back to the home page, or contact us and we will point you to the right place."
  {...props}
>
  <Button href={paths.home}>Back to Home</Button>
  <Button href={paths.contact} variant="outline">Contact Us</Button>
</MessageCard>
