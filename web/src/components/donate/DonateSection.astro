---
/*
  Donate, from Figma Section / Donate (94:5636), Amount chip (45:194),
  Checkbox (45:212), Check item (44:170) and Form errors / Donate (211:7823).

  Left: intro, three points and (desktop only) a framed photo. Right: the
  form. Amount chips are real radio buttons; typing another amount clears
  the chips and choosing a chip clears the typed amount. The summary and
  the button label follow the amount.

  On Donate the form calls POST /api/payments/paystack/initialize with the
  email and amount (what the API reads today) plus name, phone and the
  anonymous choice for step 5 to store, then sends the donor to Paystack's
  checkout. Paystack sends them back to Thank you or Payment failed.
*/
import SectionHeading from '../SectionHeading.astro';
import FramedPhoto from '../FramedPhoto.astro';
import FormField from '../FormField.astro';
import Button from '../Button.astro';
import photo from '../../assets/photos/stock-mother-two-children.jpg';
import tick from '../../assets/icons/check-rust-14.svg';
import checkWhite from '../../assets/icons/check-white.svg';
import lock from '../../assets/icons/lock-plum.svg';

// Figma note: sample amounts; the client needs to confirm the presets.
// ₦10,000 is selected at first, as in Figma.
const amounts = [5000, 10000, 25000, 50000];
const DEFAULT_AMOUNT = 10000;
const naira = (n: number) => `₦${n.toLocaleString('en-NG')}`;

const points = [
  'Secure payment through Paystack.',
  'A receipt is sent to your email.',
  'You can give anonymously. Anonymous donors are not listed on the Contributors page.',
];
---

<section class="section" aria-labelledby="donate-title" data-reveal>
  <div class="donate">
    <div class="donate__text">
      <SectionHeading id="donate-title" eyebrow="Donate" title="Donate to OMWI" />
      <p class="t-body donate__lead">
        Help us make the journey to motherhood safe for all women and eradicate period poverty. Any
        donation, no matter how big or small, is deeply appreciated.
      </p>
      <ul class="points">
        {
          points.map((point) => (
            <li class="point">
              <span class="point__tick" aria-hidden="true">
                <img src={tick.src} width="14" height="14" alt="" />
              </span>
              <span class="t-body">{point}</span>
            </li>
          ))
        }
      </ul>
      <div class="donate__photo">
        <FramedPhoto
          main={{ src: photo, alt: 'A smiling mother with her two children, making a heart with their hands', fade: 'top' }}
          desktopHeight="var(--size-donate-photo-desktop)"
        />
      </div>
    </div>

    <form class="form" novalidate data-donate-form>
      <fieldset class="amounts">
        <legend class="t-h4">1. Choose an amount</legend>
        <div class="chips">
          {
            amounts.map((amount) => (
              <label class="chip">
                <input
                  type="radio"
                  name="preset"
                  value={amount}
                  checked={amount === DEFAULT_AMOUNT}
                  aria-describedby="field-other-error"
                />
                <span class="t-h4">{naira(amount)}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <FormField name="other" label="Other amount (₦)" placeholder="Enter an amount" inputmode="numeric" />

      <hr class="form__divider" />

      <h2 class="t-h4">2. Your details</h2>
      <FormField name="name" label="Full name" placeholder="Your full name" autocomplete="name" required />
      <div class="form__group">
        <FormField
          name="email"
          label="Email address"
          type="email"
          placeholder="name@example.com"
          autocomplete="email"
          required
        />
        <p class="t-body-small form__helper" data-email-helper>We send your receipt to this address.</p>
      </div>
      <FormField name="phone" label="Phone number (optional)" type="tel" placeholder="+234" autocomplete="tel" />

      <label class="checkbox">
        <input type="checkbox" name="anonymous" />
        <span class="checkbox__box" aria-hidden="true">
          <img src={checkWhite.src} width="16" height="16" alt="" />
        </span>
        <span class="t-body">Make my donation anonymous</span>
      </label>

      <div class="summary">
        <span class="t-body">Your donation</span>
        <span class="t-h4" data-donate-summary>{naira(DEFAULT_AMOUNT)}</span>
      </div>

      <Button type="submit" class="form__submit" data-donate-submit>Donate {naira(DEFAULT_AMOUNT)}</Button>

      <div class="note">
        <img src={lock.src} width="18" height="18" alt="" />
        <p class="t-body-small" role="status" data-donate-status>
          You will be taken to Paystack to complete your payment. Your receipt arrives by email.
        </p>
      </div>
    </form>
  </div>
</section>

<style>
  .donate {
    display: flex;
    flex-direction: column;
    gap: var(--layout-split-gap);
  }
  .donate__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }
  .donate__lead {
    color: var(--text-muted);
  }
  .donate__photo {
    display: none;
  }

  .points {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .point {
    display: flex;
    align-items: flex-start;
    gap: var(--space-12);
  }
  .point__tick {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--size-check-item-tick);
    height: var(--size-check-item-tick);
    margin-top: 1px;
    border-radius: var(--radius-button);
    background: var(--bg-accent-soft);
  }

  /* Form card: 20 / 32 / 40 padding */
  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    padding: var(--space-20);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
    background: var(--bg-surface);
    box-shadow: var(--shadow-card);
  }
  .form__divider {
    width: 100%;
    height: 1px;
    border: 0;
    background: var(--border-default);
  }
  .form__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .form__helper {
    color: var(--text-muted);
  }
  .form :global(.form__submit) {
    width: 100%;
  }

  /* Amount chips: radio buttons drawn as Figma Amount chip */
  .amounts {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .amounts legend {
    padding: 0;
    margin-bottom: var(--space-20);
  }
  .chips {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-12);
  }
  .chip {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--size-amount-chip-height);
    padding: 0 var(--space-20);
    border: 1px solid var(--border-field);
    border-radius: var(--radius-button);
    background: var(--bg-field);
    color: var(--text-default);
    cursor: pointer;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .chip:hover {
    border-color: var(--border-primary);
  }
  .chip:has(input:checked) {
    border-color: var(--bg-primary);
    background: var(--bg-primary);
    color: var(--text-on-dark);
  }
  .chip:has(input:focus-visible) {
    box-shadow: 0 0 0 var(--focus-ring-width) var(--focus-ring);
  }

  /* Checkbox drawn as Figma Checkbox */
  .checkbox {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-12);
    cursor: pointer;
  }
  .checkbox input {
    position: absolute;
    opacity: 0;
    width: var(--size-checkbox);
    height: var(--size-checkbox);
    margin: 0;
  }
  .checkbox__box {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--size-checkbox);
    height: var(--size-checkbox);
    margin-top: 1px;
    border: var(--border-width-checkbox) solid var(--border-field);
    border-radius: var(--radius-checkbox);
    background: var(--bg-field);
  }
  .checkbox__box img {
    visibility: hidden;
  }
  .checkbox input:checked + .checkbox__box {
    border-color: var(--bg-primary);
    background: var(--bg-primary);
  }
  .checkbox input:checked + .checkbox__box img {
    visibility: visible;
  }
  .checkbox input:focus-visible + .checkbox__box {
    box-shadow: 0 0 0 var(--focus-ring-width) var(--focus-ring);
  }

  .summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-12);
    padding: var(--space-16) var(--space-20);
    border-radius: var(--radius-card);
    background: var(--bg-tint);
  }

  .note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-8);
    color: var(--text-muted);
  }
  .note img {
    flex: none;
    margin-top: var(--space-2);
  }
  .note [data-state='error'] {
    color: var(--text-error);
  }

  @media (min-width: 768px) {
    .form {
      padding: var(--space-32);
    }
  }
  @media (min-width: 1200px) {
    .donate {
      flex-direction: row;
      align-items: flex-start;
    }
    .donate__text,
    .form {
      flex: 1 1 0;
      min-width: 0;
    }
    .form {
      padding: var(--space-40);
    }
    .donate__photo {
      display: block;
    }
  }
</style>

<script>
  import { api, ApiError } from '../../lib/api';

  const form = document.querySelector<HTMLFormElement>('[data-donate-form]');

  if (form) {
    const other = form.elements.namedItem('other') as HTMLInputElement;
    const summary = form.querySelector<HTMLElement>('[data-donate-summary]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-donate-submit]')!;
    const status = form.querySelector<HTMLElement>('[data-donate-status]')!;
    const emailHelper = form.querySelector<HTMLElement>('[data-email-helper]')!;
    const defaultNote = status.textContent;
    const naira = (n: number) => `₦${n.toLocaleString('en-NG')}`;

    // The typed amount: whole naira, digits only (commas and ₦ are ignored).
    const typedAmount = () => Number(other.value.replace(/[^\d.]/g, '')) || 0;
    const amount = () => {
      const preset = form.querySelector<HTMLInputElement>('input[name="preset"]:checked');
      return preset ? Number(preset.value) : Math.round(typedAmount());
    };

    const update = () => {
      const value = amount();
      summary.textContent = naira(value);
      submit.textContent = value > 0 ? `Donate ${naira(value)}` : 'Donate';
    };

    form.addEventListener('change', (event) => {
      const target = event.target as HTMLInputElement;
      if (target.name === 'preset') {
        other.value = '';
        setError('other', '');
      }
      update();
    });
    other.addEventListener('input', () => {
      if (other.value) form.querySelectorAll<HTMLInputElement>('input[name="preset"]').forEach((r) => (r.checked = false));
      update();
    });

    // Error wording from Figma (Form errors / Donate).
    function setError(name: string, message: string) {
      const field = form!.elements.namedItem(name) as HTMLInputElement;
      field.setAttribute('aria-invalid', String(!!message));
      form!.querySelector(`[data-error-for="${name}"]`)!.textContent = message;
      if (name === 'email') emailHelper.hidden = !!message;
    }

    const validate = () => {
      const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
      const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
      const errors: [string, string][] = [
        ['other', amount() > 0 ? '' : 'Choose or enter an amount.'],
        ['name', name ? '' : 'Enter your full name.'],
        ['email', /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ? '' : 'Enter an email address so we can send your receipt.'],
      ];
      errors.forEach(([field, message]) => setError(field, message));
      const first = errors.find(([, message]) => message);
      if (first) (form.elements.namedItem(first[0]) as HTMLElement).focus();
      return !first;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = defaultNote;
      delete status.dataset.state;
      if (!validate()) return;

      const data = new FormData(form);
      submit.disabled = true;
      try {
        const result = await api<{ authorizationUrl?: string } | null>('/payments/paystack/initialize', {
          method: 'POST',
          body: JSON.stringify({
            amount: amount(),
            email: String(data.get('email')).trim(),
            name: String(data.get('name')).trim(),
            phone: String(data.get('phone')).trim(),
            anonymous: data.get('anonymous') === 'on',
          }),
        });
        // Only follow a Paystack checkout address.
        const url = result?.authorizationUrl;
        if (url && /^https:\/\/([a-z0-9-]+\.)*paystack\.(co|com)\//.test(url)) {
          window.location.href = url;
          return;
        }
        throw new ApiError('Something went wrong. Please try again.', 0);
      } catch (error) {
        // Show the API's own message; never a raw script error.
        status.textContent = error instanceof ApiError ? error.message : 'Something went wrong. Please try again.';
        status.dataset.state = 'error';
        submit.disabled = false;
      }
    });
  }
</script>
