---
/*
  Contact, from Figma Section / Contact (94:5031), Card/Contact (108:496),
  Form errors / Contact (211:7949) and Overlay / Message sent (110:11111).

  Left: intro and three contact cards (call, email, find us). Right: the
  message form. Side by side on desktop, stacked on tablet and mobile.

  The form sends POST /api/contact { name, email, subject, message }.
  That endpoint is added in step 5 (API upgrades); until then sending
  shows the general error. Figma shows errors for name and email only.
  On success the "Message sent" dialog opens and the form is cleared.
*/
import SectionHeading from '../SectionHeading.astro';
import FormField from '../FormField.astro';
import Button from '../Button.astro';
import { contact } from '../../config/navigation';
import phone from '../../assets/icons/phone-plum.svg';
import envelope from '../../assets/icons/envelope-plum.svg';
import mapPin from '../../assets/icons/map-pin-plum.svg';
import check from '../../assets/icons/check-plum.svg';

const cards = [
  { icon: phone, label: 'Call us', value: contact.phone, href: contact.phoneHref },
  { icon: envelope, label: 'Email us', value: contact.email, href: contact.emailHref },
  { icon: mapPin, label: 'Find us', value: contact.location },
];
---

<section class="section" aria-labelledby="contact-title" data-reveal>
  <div class="contact">
    <div class="contact__text">
      <SectionHeading id="contact-title" eyebrow="Contact" title="Contact OMWI" />
      <p class="t-body contact__lead">
        We want to hear from you. Send us a message and someone from our team will get back to you.
      </p>
      <ul class="cards">
        {
          cards.map((card) => (
            <li class="card">
              <span class="card__tile" aria-hidden="true">
                <img src={card.icon.src} width="28" height="28" alt="" />
              </span>
              <div class="card__body">
                <p class="t-body-small card__label">{card.label}</p>
                {card.href ? (
                  <a class="t-h4 card__value" href={card.href}>
                    {card.value}
                  </a>
                ) : (
                  <p class="t-h4 card__value">{card.value}</p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <form class="form" novalidate data-contact-form>
      <h2 class="t-h3">Send us a message</h2>
      <div class="form__row">
        <FormField name="name" label="Full name" placeholder="Your full name" autocomplete="name" required />
        <FormField
          name="email"
          label="Email address"
          type="email"
          placeholder="name@example.com"
          autocomplete="email"
          required
        />
      </div>
      <FormField name="subject" label="Subject" placeholder="What is your message about?" />
      <FormField name="message" label="Your message" type="textarea" placeholder="Write your message here" />
      <Button type="submit" class="form__submit" data-contact-submit>Send Message</Button>
      <p class="t-body-small form__note" role="status" data-contact-status>We reply by email.</p>
    </form>
  </div>

  <dialog class="sent" aria-labelledby="sent-title" data-contact-sent>
    <span class="sent__tile" aria-hidden="true">
      <img src={check.src} width="28" height="28" alt="" />
    </span>
    <h2 class="t-h4" id="sent-title">Message sent</h2>
    <p class="t-body sent__text">Thank you for contacting OMWI. We have received your message.</p>
    <Button autofocus data-contact-close>Close</Button>
  </dialog>
</section>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    gap: var(--layout-split-gap);
  }
  .contact__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }
  .contact__lead {
    color: var(--text-muted);
  }

  .cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    padding: var(--space-24);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
    background: var(--bg-surface);
  }
  .card__tile {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--size-icon-tile);
    height: var(--size-icon-tile);
    border-radius: var(--radius-card);
    background: var(--bg-soft);
  }
  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }
  .card__label {
    color: var(--text-muted);
  }
  .card__value {
    color: var(--text-default);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  a.card__value:hover {
    color: var(--text-primary);
  }

  /* Form card: 20 / 32 / 40 padding (mobile / tablet / desktop) */
  .form {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-20);
    padding: var(--space-20);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
    background: var(--bg-surface);
    box-shadow: var(--shadow-card);
  }
  .form__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }
  .form :global(.form__submit) {
    align-self: flex-start;
  }
  .form__note {
    color: var(--text-muted);
  }
  .form__note[data-state='error'] {
    color: var(--text-error);
  }

  /* "Message sent" dialog */
  .sent {
    width: min(var(--size-overlay-width), calc(100% - 2 * var(--layout-page-padding)));
    margin: auto;
    padding: var(--space-32);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
    background: var(--bg-surface);
    box-shadow: var(--shadow-overlay);
    text-align: center;
  }
  .sent[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-16);
  }
  .sent::backdrop {
    background: var(--bg-backdrop);
  }
  .sent__tile {
    display: flex;
    padding: var(--space-14);
    border-radius: var(--radius-card);
    background: var(--bg-success-soft);
  }
  .sent__text {
    color: var(--text-muted);
  }

  @media (min-width: 768px) {
    .form {
      padding: var(--space-32);
    }
    .form__row {
      flex-direction: row;
    }
    .form__row > :global(*) {
      flex: 1 1 0;
    }
  }
  @media (min-width: 1200px) {
    .contact {
      flex-direction: row;
      align-items: flex-start;
    }
    .contact__text,
    .form {
      flex: 1 1 0;
      min-width: 0;
    }
    .form {
      padding: var(--space-40);
    }
  }
</style>

<script>
  import { api } from '../../lib/api';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-contact-sent]');

  if (form && dialog) {
    const status = form.querySelector<HTMLElement>('[data-contact-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-contact-submit]')!;
    const defaultNote = status.textContent;

    // Error wording from Figma (Form errors / Contact).
    const checks: Record<string, (v: string) => string> = {
      name: (v) => (v.trim() ? '' : 'Enter your full name.'),
      email: (v) => (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()) ? '' : 'Enter an email address so we can reply.'),
    };

    const validate = () => {
      let firstBad: HTMLElement | null = null;
      for (const [name, check] of Object.entries(checks)) {
        const field = form.elements.namedItem(name) as HTMLInputElement;
        const message = check(field.value);
        const error = form.querySelector(`[data-error-for="${name}"]`)!;
        error.textContent = message;
        field.setAttribute('aria-invalid', String(!!message));
        if (message && !firstBad) firstBad = field;
      }
      firstBad?.focus();
      return !firstBad;
    };

    // Clear a field's error as soon as it is fixed.
    form.addEventListener('input', (event) => {
      const field = event.target as HTMLInputElement;
      if (field.getAttribute('aria-invalid') === 'true' && checks[field.name] && !checks[field.name](field.value)) {
        field.setAttribute('aria-invalid', 'false');
        form.querySelector(`[data-error-for="${field.name}"]`)!.textContent = '';
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = defaultNote;
      delete status.dataset.state;
      if (!validate()) return;

      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      submit.disabled = true;
      try {
        await api('/contact', {
          method: 'POST',
          body: JSON.stringify({
            name: data.name.trim(),
            email: data.email.trim(),
            subject: data.subject.trim(),
            message: data.message.trim(),
          }),
        });
        form.reset();
        dialog.showModal();
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Something went wrong. Please try again.';
        status.dataset.state = 'error';
      } finally {
        submit.disabled = false;
      }
    });

    dialog.querySelector('[data-contact-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => submit.focus());
  }
</script>
