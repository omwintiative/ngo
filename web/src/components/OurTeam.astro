---
/*
  "Meet the team" (Home and About), from Figma Section / Our team (91:6781).
  1 column on phones, 2 on tablets, 4 on desktop. People come from
  src/data/team.ts.
*/
import SectionHeading from './SectionHeading.astro';
import TeamCard from './TeamCard.astro';
import { team } from '../data/team';
---

<section class="section section--tint" aria-labelledby="team-title">
  <SectionHeading id="team-title" eyebrow="Our Team" title="Meet the team" align="center" data-reveal />
  <div class="team__grid">
    {team.map((member, i) => <TeamCard member={member} data-reveal style={`--reveal-index: ${i}`} />)}
  </div>
</section>

<style>
  /* Phones: one card per row (Ifeanyi, 20 Oct 2026; Figma shows 2) */
  .team__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--layout-gap);
  }
  @media (min-width: 768px) {
    .team__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1200px) {
    .team__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
