---
/*
  Team card, from Figma Card/Team (108:467): portrait (320 tall, fade from
  the bottom), name and role. Hover: plum border, shadow, the portrait
  zooms under a plum wash. Without a portrait it shows the plum placeholder
  from the design.
*/
import Photo from './Photo.astro';
import type { TeamMember } from '../data/team';

interface Props {
  member: TeamMember;
  class?: string;
  [attr: string]: unknown;
}

const { member, class: className, ...rest } = Astro.props;
---

<article class:list={['team-card', className]} data-hover-card {...rest}>
  {
    member.photo ? (
      <Photo
        class="team-card__photo"
        src={member.photo}
        alt={member.photoAlt ?? `Portrait of ${member.name}`}
        fade="bottom"
        widths={[300, 600]}
        sizes="(min-width: 1200px) 282px, (min-width: 768px) 332px, 50vw"
      />
    ) : (
      <div class="team-card__photo team-card__placeholder" aria-hidden="true">
        <span class="team-card__tint" />
        <span class="team-card__fade" />
      </div>
    )
  }
  <div class="team-card__body">
    <h3 class="t-h4">{member.name}</h3>
    <p class="t-body-small team-card__role">{member.role}</p>
  </div>
</article>

<style>
  .team-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
    background: var(--bg-surface);
    transition:
      border-color 200ms ease,
      box-shadow 200ms ease;
  }
  .team-card:hover {
    border-color: var(--border-primary);
    box-shadow: var(--shadow-card-hover);
  }

  .team-card :global(.team-card__photo) {
    height: var(--size-team-photo-height);
    border-radius: 0;
  }
  .team-card__placeholder {
    position: relative;
    background: var(--plum-400);
  }
  .team-card__tint,
  .team-card__fade {
    position: absolute;
    inset: 0;
  }
  .team-card__tint {
    background: var(--photo-tint);
    mix-blend-mode: soft-light;
  }
  .team-card__fade {
    background: linear-gradient(0deg, var(--photo-fade-color) 0%, transparent 72%);
  }

  .team-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-20) var(--space-24) var(--space-24);
  }
  .team-card__role {
    color: var(--text-muted);
  }
</style>
