---
/*
  Gallery strip, from Figma Gallery strip (86:626): a full-width row of
  outreach photos that slides left one photo every 2.5 seconds and loops.
  Pauses while hovered or focused and when the tab is hidden. For visitors
  who ask for reduced motion it does not slide: the row fades out, moves on
  one photo and fades back in (gentle version, Ifeanyi, 19 Oct 2026).

  The photos are listed twice so the loop never shows a gap; the second copy
  is hidden from screen readers.

  The photos passed in show first. The Home strip photos from Admin ·
  Gallery (GET /api/gallery) replace them between two steps when they
  arrive; if the API cannot be reached or has no photos, the first ones stay.
*/
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';

interface Props {
  photos: { src: ImageMetadata; alt: string; width: 'square' | 'wide' | 'narrow' }[];
}

const { photos } = Astro.props;
---

<div class="strip" data-strip>
  <ul class="strip__track" data-strip-track>
    {
      [0, 1].map((copy) =>
        photos.map((photo) => (
          <li class:list={['strip__item', `strip__item--${photo.width}`]} aria-hidden={copy === 1 ? 'true' : undefined}>
            <Photo
              class="strip__photo"
              src={photo.src}
              alt={copy === 1 ? '' : photo.alt}
              widths={[300, 600, 900]}
              sizes="420px"
            />
          </li>
        )),
      )
    }
  </ul>
</div>

<style>
  .strip {
    overflow: hidden;
    height: var(--size-strip-height);
  }
  .strip__track {
    display: flex;
    gap: var(--space-16);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Reduced motion: the script fades the row instead of sliding it */
  @media (prefers-reduced-motion: reduce) {
    .strip__track {
      transition: opacity 400ms ease !important;
    }
  }
  .strip__item {
    flex: none;
    height: var(--size-strip-height);
  }
  /* Figma widths: square 300, wide 420, narrow 260 */
  .strip__item--square {
    width: var(--size-strip-height);
  }
  .strip__item--wide {
    width: calc(var(--size-strip-height) * 1.4);
  }
  .strip__item--narrow {
    width: calc(var(--size-strip-height) * 0.8667);
  }
  .strip__item :global(.strip__photo) {
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { fetchGallery, homePhotos, showPhoto, type GalleryPhoto } from '../lib/gallery';

  const STEP_MS = 2500;
  // Figma widths, in order, repeated for longer rows.
  const WIDTHS = ['square', 'wide', 'narrow', 'wide', 'square', 'narrow'];
  const gallery = fetchGallery().then(homePhotos).catch((): GalleryPhoto[] => []);
  const MOVE_MS = 700;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-strip]').forEach((strip) => {
    const track = strip.querySelector<HTMLElement>('[data-strip-track]');
    if (!track) return;
    let paused = false;
    let replacement: HTMLElement[] | null = null;

    gallery.then((photos) => {
      const model = track.querySelector<HTMLElement>('.strip__item');
      if (!photos.length || !model) return;
      replacement = [0, 1].flatMap((copy) =>
        photos.map((photo, i) => {
          const item = model.cloneNode(true) as HTMLElement;
          item.className = item.className.replace(/strip__item--\w+/, `strip__item--${WIDTHS[i % WIDTHS.length]}`);
          if (copy === 1) item.setAttribute('aria-hidden', 'true');
          else item.removeAttribute('aria-hidden');
          showPhoto(item.querySelector<HTMLImageElement>('.photo__img')!, photo, [300, 600, 900], copy === 1 ? '' : photo.alt);
          return item;
        }),
      );
    });

    const pause = () => (paused = true);
    const resume = () => (paused = false);
    strip.addEventListener('mouseenter', pause);
    strip.addEventListener('mouseleave', resume);
    strip.addEventListener('focusin', pause);
    strip.addEventListener('focusout', resume);

    // Move left by one photo (Figma: 0.7s ease-in-out every 2.5s), then put
    // that photo at the end of the row. The photos' own hover transitions
    // bubble up to the track, so only the track's transform ends the step.
    let moving = false;
    const fadeStep = (first: HTMLElement) => {
      moving = true;
      const done = (event: TransitionEvent) => {
        if (event.target !== track || event.propertyName !== 'opacity') return;
        track.removeEventListener('transitionend', done);
        track.append(first);
        track.style.opacity = '';
        moving = false;
      };
      track.addEventListener('transitionend', done);
      track.style.opacity = '0';
    };
    const step = () => {
      if (moving) return;
      if (replacement) {
        track.replaceChildren(...replacement);
        replacement = null;
        return;
      }
      if (paused || document.hidden) return;
      const first = track.firstElementChild as HTMLElement | null;
      if (!first) return;
      if (reduced.matches) return fadeStep(first);
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      moving = true;
      track.style.transition = `transform ${MOVE_MS}ms ease-in-out`;
      track.style.transform = `translateX(${-(first.offsetWidth + gap)}px)`;
      const done = (event: TransitionEvent) => {
        if (event.target !== track || event.propertyName !== 'transform') return;
        track.removeEventListener('transitionend', done);
        track.style.transition = 'none';
        track.append(first);
        track.style.transform = 'none';
        moving = false;
      };
      track.addEventListener('transitionend', done);
    };

    setInterval(step, STEP_MS);
  });
</script>
