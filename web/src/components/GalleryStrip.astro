---
/*
  Gallery strip, from Figma Gallery strip (86:626): a full-width row of
  outreach photos that slides left one photo every 2.5 seconds and loops.
  Pauses while hovered or focused, when the tab is hidden, and never moves
  for visitors who ask for reduced motion (Figma "Read me").

  The photos are listed twice so the loop never shows a gap; the second copy
  is hidden from screen readers.
*/
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';

interface Props {
  photos: { src: ImageMetadata; alt: string; width: 'square' | 'wide' | 'narrow' }[];
}

const { photos } = Astro.props;
---

<div class="strip" data-strip>
  <ul class="strip__track" data-strip-track>
    {
      [0, 1].map((copy) =>
        photos.map((photo) => (
          <li class:list={['strip__item', `strip__item--${photo.width}`]} aria-hidden={copy === 1 ? 'true' : undefined}>
            <Photo
              class="strip__photo"
              src={photo.src}
              alt={copy === 1 ? '' : photo.alt}
              widths={[300, 600, 900]}
              sizes="420px"
            />
          </li>
        )),
      )
    }
  </ul>
</div>

<style>
  .strip {
    overflow: hidden;
    height: var(--size-strip-height);
  }
  .strip__track {
    display: flex;
    gap: var(--space-16);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .strip__item {
    flex: none;
    height: var(--size-strip-height);
  }
  /* Figma widths: square 300, wide 420, narrow 260 */
  .strip__item--square {
    width: var(--size-strip-height);
  }
  .strip__item--wide {
    width: calc(var(--size-strip-height) * 1.4);
  }
  .strip__item--narrow {
    width: calc(var(--size-strip-height) * 0.8667);
  }
  .strip__item :global(.strip__photo) {
    width: 100%;
    height: 100%;
  }
</style>

<script>
  const STEP_MS = 2500;
  const MOVE_MS = 700;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-strip]').forEach((strip) => {
    const track = strip.querySelector<HTMLElement>('[data-strip-track]');
    if (!track) return;
    let paused = false;

    const pause = () => (paused = true);
    const resume = () => (paused = false);
    strip.addEventListener('mouseenter', pause);
    strip.addEventListener('mouseleave', resume);
    strip.addEventListener('focusin', pause);
    strip.addEventListener('focusout', resume);

    // Move left by one photo, then put that photo at the end of the row.
    const step = () => {
      if (paused || document.hidden || reduced.matches) return;
      const first = track.firstElementChild as HTMLElement | null;
      if (!first) return;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      track.style.transition = `transform ${MOVE_MS}ms ease`;
      track.style.transform = `translateX(${-(first.offsetWidth + gap)}px)`;
      track.addEventListener(
        'transitionend',
        () => {
          track.style.transition = 'none';
          track.append(first);
          track.style.transform = 'none';
        },
        { once: true },
      );
    };

    setInterval(step, STEP_MS);
  });
</script>
