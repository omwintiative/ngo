---
/*
  Site header, from Figma Header (37:97), Nav dropdown (37:98) and Mobile
  menu (37:103).

  - Fixed to the top of every page. Smoked glass at all times: plum/950 at
    75% with a background blur (Figma "Read me": the header does not change
    as the page scrolls).
  - Desktop (1200px+): links, the Get Involved dropdown and "Donate Now".
  - Tablet and mobile: "Donate" and a menu button that opens a full-screen
    panel (a modal <dialog>, so focus stays inside it and Escape closes it).

  Links come from src/config/navigation.ts.
*/
import Logo from './Logo.astro';
import Button from './Button.astro';
import { mainNav, donateCta, paths, isGroup, isCurrent } from '../config/navigation';
import caretDown from '../assets/icons/caret-down-white.svg';
import caretUp from '../assets/icons/caret-up-white.svg';
import caretUpPlum from '../assets/icons/caret-up-plum.svg';
import listIcon from '../assets/icons/list-white.svg';
import closeIcon from '../assets/icons/x-plum.svg';

const pathname = Astro.url.pathname;
const current = (href: string) => (isCurrent(href, pathname) ? 'page' : undefined);
const homeAlt = 'Ọmụgwọ Maternal Welfare Initiative, home';
---

<header class="site-header" data-site-header>
  <div class="site-header__bar">
    <a class="site-header__logo" href={paths.home}>
      <Logo variant="on-dark" alt={homeAlt} class="site-header__logo-img" />
    </a>

    <nav class="desktop-nav" aria-label="Main">
      <ul class="desktop-nav__list">
        {
          mainNav.map((item) =>
            isGroup(item) ? (
              <li class="desktop-nav__item" data-dropdown>
                <button
                  type="button"
                  class="desktop-nav__link desktop-nav__trigger t-button"
                  aria-expanded="false"
                  aria-controls={`nav-${item.id}`}
                  data-dropdown-trigger
                >
                  {item.label}
                  <img class="caret caret--closed" src={caretDown.src} width={caretDown.width} height={caretDown.height} alt="" />
                  <img class="caret caret--open" src={caretUp.src} width={caretUp.width} height={caretUp.height} alt="" />
                </button>
                <ul class="dropdown" id={`nav-${item.id}`} hidden>
                  {item.children.map((child) => (
                    <li>
                      <a class="dropdown__link t-button" href={child.href} aria-current={current(child.href)}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="desktop-nav__item">
                <a class="desktop-nav__link t-button" href={item.href} aria-current={current(item.href)}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <Button href={donateCta.href} arrow class="donate donate--full">{donateCta.label}</Button>
      <Button href={donateCta.href} class="donate donate--compact">{donateCta.compactLabel}</Button>
      <button
        type="button"
        class="icon-button icon-button--on-dark menu-toggle"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-toggle
      >
        <img src={listIcon.src} width={listIcon.width} height={listIcon.height} alt="" />
        <span class="visually-hidden">Menu</span>
      </button>
    </div>
  </div>
</header>

<dialog class="menu-panel" id="site-menu" aria-label="Menu" data-menu>
  <div class="menu-panel__top">
    <div class="menu-panel__bar">
      <a class="menu-panel__logo" href={paths.home}>
        <Logo variant="colour" alt={homeAlt} class="site-header__logo-img" />
      </a>
      <button type="button" class="icon-button" data-menu-close autofocus>
        <img src={closeIcon.src} width={closeIcon.width} height={closeIcon.height} alt="" />
        <span class="visually-hidden">Close menu</span>
      </button>
    </div>

    <nav aria-label="Main">
      <ul class="menu-links">
        {
          mainNav.map((item) =>
            isGroup(item) ? (
              <li>
                <button
                  type="button"
                  class="menu-links__row t-h4"
                  aria-expanded="true"
                  aria-controls={`menu-${item.id}`}
                  data-submenu-trigger
                >
                  {item.label}
                  <img class="menu-links__caret" src={caretUpPlum.src} width="18" height="18" alt="" />
                </button>
                <ul class="menu-links__sub" id={`menu-${item.id}`}>
                  {item.children.map((child) => (
                    <li>
                      <a class="menu-links__sublink t-body" href={child.href} aria-current={current(child.href)}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a class="menu-links__row t-h4" href={item.href} aria-current={current(item.href)}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>
  </div>

  <Button href={donateCta.href} arrow class="menu-panel__donate">{donateCta.label}</Button>
</dialog>

<style is:global>
  /* In-page links land below the fixed header */
  html {
    scroll-padding-top: var(--layout-header-height);
  }
  /* The page must not scroll behind the open menu */
  html.menu-open {
    overflow: hidden;
  }
</style>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    background: var(--bg-header);
    -webkit-backdrop-filter: blur(var(--blur-header));
    backdrop-filter: blur(var(--blur-header));
    color: var(--text-on-dark);
  }

  /* Keyboard focus shows in white on the dark glass */
  .site-header :focus-visible {
    outline-color: var(--text-on-dark);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
    height: var(--layout-header-height);
    padding-inline: var(--layout-page-padding);
  }

  .site-header__logo {
    flex: none;
    border-radius: var(--radius-sm);
  }

  /* Logo: 105.78 x 39.36 on tablet and mobile, 129 x 48 on desktop */
  .site-header__logo-img {
    width: var(--size-logo-width-compact);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-10);
  }

  /* ----- Desktop links ----- */
  .desktop-nav {
    display: none;
  }

  .desktop-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-24);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .desktop-nav__item {
    position: relative;
  }

  /* 12px above and below the 20px text: a 44px tap area, same look */
  .desktop-nav__link {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-12) 0;
    border: 0;
    background: none;
    color: var(--text-on-dark);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  /* Not in Figma: an underline so the pointer has a hover cue */
  .desktop-nav__link:hover {
    text-decoration: underline;
    text-underline-offset: var(--space-6);
  }

  .caret {
    flex: none;
  }
  .caret--open,
  .desktop-nav__trigger[aria-expanded='true'] .caret--closed {
    display: none;
  }
  .desktop-nav__trigger[aria-expanded='true'] .caret--open {
    display: block;
  }

  /* ----- Get Involved dropdown ----- */
  .dropdown {
    position: absolute;
    left: calc(-1 * var(--space-16));
    top: calc(100% + var(--space-12));
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: var(--size-dropdown-width);
    margin: 0;
    padding: var(--space-8);
    list-style: none;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-dropdown);
  }
  .dropdown[hidden] {
    display: none;
  }

  .dropdown :focus-visible {
    outline-color: var(--bg-primary);
  }

  .dropdown__link {
    display: block;
    padding: var(--space-12) var(--space-14);
    border-radius: var(--radius-item);
    color: var(--text-default);
    text-decoration: none;
  }
  .dropdown__link:hover,
  .dropdown__link:focus-visible {
    background: var(--bg-tint);
    color: var(--text-primary);
  }

  /* ----- Buttons in the bar ----- */
  .donate--full {
    display: none;
  }

  /* On the dark glass the focus ring is white, as on the On dark button */
  .donate {
    --btn-ring: var(--focus-ring-on-dark);
  }

  .icon-button {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--size-icon-button);
    height: var(--size-icon-button);
    padding: 0;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-button);
    background: var(--bg-surface);
    cursor: pointer;
  }
  .icon-button:hover {
    background: var(--bg-soft);
  }

  .icon-button--on-dark {
    border-color: var(--border-on-dark-soft);
    background: transparent;
  }
  .icon-button--on-dark:hover {
    background: var(--bg-icon-on-dark-hover);
  }

  @media (min-width: 1200px) {
    .site-header__logo-img {
      width: var(--size-logo-width);
    }
    .desktop-nav {
      display: block;
    }
    .donate--full {
      display: inline-flex;
    }
    .donate--compact,
    .menu-toggle {
      display: none;
    }
  }

  /* Figma spaces the links 32 apart at 1440. Below 1280 that no longer fits. */
  @media (min-width: 1280px) {
    .desktop-nav__list {
      gap: var(--space-32);
    }
  }

  /* ----- Tablet and mobile menu panel ----- */
  .menu-panel {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0 var(--layout-page-padding) var(--space-28);
    border: 0;
    background: var(--bg-surface);
    color: var(--text-default);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu-panel[open] {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-24);
  }

  .menu-panel__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .menu-panel__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* the panel only shows below 1200px, where the header is 72 tall */
    height: var(--layout-header-height);
  }

  .menu-panel__logo {
    border-radius: var(--radius-sm);
  }

  .menu-links,
  .menu-links__sub {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu-links__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--space-16) 0;
    border: 0;
    border-bottom: 1px solid var(--border-default);
    background: none;
    color: var(--text-default);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  /* Current page, as Home is shown in Figma */
  .menu-links__row[aria-current='page'],
  .menu-links__sublink[aria-current='page'] {
    color: var(--text-accent);
  }

  /* Open group: no line under it (Figma). Closed: caret points down. */
  .menu-links__row[aria-expanded='true'] {
    border-bottom: 0;
  }
  .menu-links__row[aria-expanded='false'] .menu-links__caret {
    transform: rotate(180deg);
  }

  .menu-links__sublink {
    display: block;
    padding: var(--space-12) 0 var(--space-12) var(--space-20);
    color: var(--text-muted);
    text-decoration: none;
  }

  /* Not in Figma: an underline so the pointer has a hover cue */
  .menu-links__row:hover,
  .menu-links__sublink:hover {
    text-decoration: underline;
    text-underline-offset: var(--space-6);
  }

  .menu-panel__donate {
    width: 100%;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  // Desktop dropdowns: open on click, Enter or Space (it is a real button).
  // Escape closes and returns focus to the trigger; so does clicking or
  // tabbing away.
  header?.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');
    const list = trigger && document.getElementById(trigger.getAttribute('aria-controls') ?? '');
    if (!trigger || !list) return;

    const setOpen = (open: boolean) => {
      trigger.setAttribute('aria-expanded', String(open));
      list.hidden = !open;
    };
    const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';

    trigger.addEventListener('click', () => setOpen(!isOpen()));
    item.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        trigger.focus();
      }
    });
    item.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (next && !item.contains(next)) setOpen(false);
    });
    document.addEventListener('click', (event) => {
      if (isOpen() && !item.contains(event.target as Node)) setOpen(false);
    });
  });

  // Tablet and mobile menu. showModal() keeps focus in the panel and closes
  // it on Escape; the 'close' event tidies up whichever way it was closed.
  if (menu && toggle) {
    const root = document.documentElement;

    toggle.addEventListener('click', () => {
      menu.showModal();
      toggle.setAttribute('aria-expanded', 'true');
      root.classList.add('menu-open');
    });

    menu.addEventListener('close', () => {
      toggle.setAttribute('aria-expanded', 'false');
      root.classList.remove('menu-open');
      toggle.focus();
    });

    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());

    // The Get Involved group inside the panel opens and closes.
    menu.querySelectorAll<HTMLButtonElement>('[data-submenu-trigger]').forEach((button) => {
      const sub = document.getElementById(button.getAttribute('aria-controls') ?? '');
      button.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(open));
        if (sub) sub.hidden = !open;
      });
    });

    // If the window grows to desktop width, the panel is no longer needed.
    window.matchMedia('(min-width: 1200px)').addEventListener('change', (event) => {
      if (event.matches && menu.open) menu.close();
    });
  }
</script>
