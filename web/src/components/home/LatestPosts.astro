---
/*
  Home "Latest from the blog", from Figma Section / Latest from the blog
  (91:6883). The three newest posts from GET /api/blogs. While they load the
  section shows three skeleton cards; if there are no posts or the API is
  down, the section hides again, so the page never shows samples. Without
  JavaScript it stays hidden.
*/
import SectionHeading from '../SectionHeading.astro';
import Button from '../Button.astro';
import PostCardTemplate from '../PostCardTemplate.astro';
import PostGrid from '../PostGrid.astro';
import { paths } from '../../config/navigation';
---

<section class="section section--tint" aria-labelledby="posts-title" hidden data-latest-posts>
  <SectionHeading id="posts-title" eyebrow="Stories and Insights" title="Latest from the blog" align="center" />
  <PostGrid skeletons={3} data-latest-list />
  <div class="posts__actions">
    <Button href={paths.blog} variant="outline" arrow class="posts__button">View All Posts</Button>
  </div>
  <PostCardTemplate />
</section>

<style>
  .posts__actions {
    display: flex;
    justify-content: center;
  }
  .posts__actions :global(.posts__button) {
    width: 100%;
  }
  @media (min-width: 768px) {
    .posts__actions :global(.posts__button) {
      width: auto;
    }
  }
</style>

<script>
  import { fetchPosts, renderPostCard } from '../../lib/posts';

  const section = document.querySelector<HTMLElement>('[data-latest-posts]');
  const list = section?.querySelector<HTMLElement>('[data-latest-list]');

  if (section && list) {
    section.hidden = false;
    fetchPosts()
      .then((posts) => {
        if (Array.isArray(posts) && posts.length > 0) {
          list.replaceChildren(...posts.slice(0, 3).map(renderPostCard));
        } else {
          section.hidden = true;
        }
      })
      .catch(() => {
        // API not reachable: hide the section
        section.hidden = true;
      });
  }
</script>
