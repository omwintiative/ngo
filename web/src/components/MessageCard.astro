---
/*
  Message card, from Figma Section / Message (404 128:7211, Thank you
  94:6070, Payment failed 94:6305): a round icon tile, a heading, a line of
  text and the buttons (the default slot). Card padding 28 / 48 / 56; on
  phones the buttons stack at full width.
*/
import type { ImageMetadata } from 'astro';

interface Props {
  icon: ImageMetadata;
  /** Icon tile colour: plum (`soft`) or orange (`accent`, Payment failed). */
  tone?: 'soft' | 'accent';
  title: string;
  text: string;
  class?: string;
  [attr: string]: unknown;
}

const { icon, tone = 'soft', title, text, class: className, ...rest } = Astro.props;
---

<div class:list={['message', className]} {...rest}>
  <span class:list={['message__tile', `message__tile--${tone}`]} aria-hidden="true">
    <img src={icon.src} width="36" height="36" alt="" />
  </span>
  <h2 class="t-h2">{title}</h2>
  <p class="t-body-large message__text">{text}</p>
  <div class="message__buttons">
    <slot />
  </div>
</div>

<style>
  .message {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-20);
    width: 100%;
    max-width: var(--size-message-card-width);
    padding: var(--space-28);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
    background: var(--bg-surface);
    box-shadow: var(--shadow-card);
    text-align: center;
  }
  .message__tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--size-icon-tile-large);
    height: var(--size-icon-tile-large);
    border-radius: 50%;
  }
  .message__tile--soft {
    background: var(--bg-soft);
  }
  .message__tile--accent {
    background: var(--bg-accent-soft);
  }
  .message__tile img {
    width: var(--size-icon-large);
    height: var(--size-icon-large);
  }
  .message__text {
    color: var(--text-muted);
  }
  .message__buttons {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    width: 100%;
  }

  @media (min-width: 768px) {
    .message {
      padding: var(--space-48);
    }
    .message__buttons {
      flex-direction: row;
      justify-content: center;
      width: auto;
    }
  }
  @media (min-width: 1200px) {
    .message {
      padding: var(--space-56);
    }
  }
</style>
