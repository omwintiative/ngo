---
/*
  About "What guides us", from Figma Section / What guides us (152:10142).
  A photo with a caption and four principle cards. Photo beside the cards
  on tablet and desktop, above them on mobile.

  Icons: the desktop frame uses the heart on all four cards; the mobile
  frame gives each card its own icon. The distinct icons are used at every
  size (to confirm with Ifeanyi).
*/
import { Image } from 'astro:assets';
import SectionHeading from '../SectionHeading.astro';
import photo from '../../assets/photos/stock-doctor-and-girl.jpg';
import heart from '../../assets/icons/heart-plum.svg';
import handHeart from '../../assets/icons/hand-heart-plum.svg';
import shieldCheck from '../../assets/icons/shield-check-plum.svg';
import arrowUpRight from '../../assets/icons/arrow-up-right-plum-24.svg';

// Copy as in Figma.
const principles = [
  {
    icon: heart,
    title: 'Our Vision',
    text: 'A society where every woman in underserved communities thrives with unrestricted access to comprehensive reproductive healthcare, dignified period equity, and empowering education.',
  },
  {
    icon: handHeart,
    title: 'Our Mission',
    text: 'Rooted in empathy and integrity, our mission is to combat maternal mortality and period poverty through the delivery of comprehensive primary reproductive healthcare and literacy to women in underserved communities, ensuring safe motherhood for all and dignified period equity.',
  },
  {
    icon: shieldCheck,
    title: 'Our Standard',
    text: 'Person-Centered Innovations, Uncompromising Integrity, True Health Equity',
  },
  {
    icon: arrowUpRight,
    title: 'Our Future',
    text: 'Our aim is building a movement to make women’s health equity and reproductive health dignity a global standard. By dismantling geographic and socioeconomic barriers, we are fostering a world where every woman is empowered with the knowledge to lead her own reproductive health journey with confidence.',
  },
];
---

<section class="section guides" aria-labelledby="guides-title">
  <SectionHeading id="guides-title" eyebrow="Why We Exist" title="What guides us" align="center" data-reveal />

  <div class="guides__layout">
    <figure class="guides__media" data-reveal>
      <Image
        class="guides__img"
        src={photo}
        alt="A doctor listening to a girl’s heartbeat with a stethoscope while a woman looks on"
        widths={[400, 700, 1100]}
        sizes="(min-width: 1200px) 560px, (min-width: 768px) 360px, 100vw"
      />
      <span class="guides__fade" aria-hidden="true"></span>
      <span class="guides__accent" aria-hidden="true">
        <img src={heart.src} width="28" height="28" alt="" />
      </span>
      <figcaption class="guides__caption">
        <span class="t-eyebrow guides__caption-label">Community health</span>
        <span class="guides__caption-title">Care that reaches every corner</span>
      </figcaption>
    </figure>

    <ul class="guides__stack">
      {
        principles.map((item, i) => (
          <li class="principle" data-reveal style={`--reveal-index: ${i}`}>
            <span class="principle__tile" aria-hidden="true">
              <img src={item.icon.src} width="24" height="24" alt="" />
            </span>
            <h3 class="t-h4">{item.title}</h3>
            <p class="t-body principle__text">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Figma: 32 / 48 / 64 between heading and content in this section */
  .guides {
    gap: var(--space-32);
    background: var(--bg-soft);
  }

  .guides__layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }

  .guides__media {
    position: relative;
    height: var(--size-guides-media-height-mobile);
    overflow: hidden;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
  }
  .guides__img,
  .guides__fade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .guides__img {
    object-fit: cover;
  }
  .guides__fade {
    background: linear-gradient(180deg, transparent 0%, var(--media-fade-color) 100%);
  }
  .guides__accent {
    position: absolute;
    top: var(--space-16);
    left: var(--space-16);
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--size-icon-tile);
    height: var(--size-icon-tile);
    border-radius: var(--radius-card);
    background: var(--bg-soft);
  }
  .guides__caption {
    position: absolute;
    right: var(--space-16);
    bottom: var(--space-40);
    left: var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-16);
    border-radius: var(--radius-button);
    background: var(--bg-caption);
    box-shadow: var(--shadow-caption);
  }
  .guides__caption-label {
    color: var(--text-muted);
  }
  .guides__caption-title {
    font-size: var(--type-body-default-size);
    line-height: var(--type-body-small-line);
    font-weight: var(--weight-semibold);
  }

  .guides__stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .principle {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    /* Figma draws the border inside the card: take it off the padding */
    padding: calc(var(--space-24) - 1px);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-card);
    background:
      linear-gradient(90deg, var(--card-glow) 0%, transparent 75%),
      var(--bg-surface);
    box-shadow: var(--shadow-principle);
  }
  .principle h3 {
    margin-bottom: calc(-1 * var(--space-4));
  }
  .principle__tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--size-icon-tile-small);
    height: var(--size-icon-tile-small);
    border-radius: var(--radius-card);
    background: var(--bg-soft);
  }
  .principle__text {
    color: var(--text-muted);
  }

  @media (min-width: 768px) {
    .guides {
      gap: var(--space-48);
    }
    .guides__layout {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-24);
    }
    .guides__media {
      flex: none;
      width: var(--size-guides-media-width-tablet);
      height: var(--size-guides-media-height-tablet);
    }
    .guides__accent {
      top: var(--space-24);
      left: var(--space-24);
    }
    .guides__caption {
      right: var(--space-24);
      bottom: var(--space-48);
      left: var(--space-24);
    }
    .guides__stack {
      flex: 1;
      min-width: 0;
    }
  }

  @media (min-width: 1200px) {
    .guides {
      gap: var(--space-64);
    }
    .guides__layout {
      gap: var(--space-48);
    }
    .guides__media {
      width: var(--size-guides-media-width);
      height: var(--size-guides-media-height);
    }
  }
</style>
