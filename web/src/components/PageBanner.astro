---
/*
  Page banner, from Figma Page banner (37:165): photo, brand tint, dark
  overlay, the OMWI mark, the page title (the page's <h1>) and a
  breadcrumb. 260 / 300 / 340 tall (layout/banner-height).

  Figma "Read me": on load the photo settles from 108% to 100% while the
  heading rises and fades in over 800ms. Off with reduced motion.
*/
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { paths } from '../config/navigation';
import defaultPhoto from '../assets/photos/stock-health-workers-team.jpg';
import watermark from '../assets/graphics/watermark.svg';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  /** Trail after "Home"; the last item is the current page (no link). */
  crumbs: Crumb[];
  image?: ImageMetadata;
  /** CSS object-position for the photo (Figma crop). */
  imagePosition?: string;
}

const { title, crumbs, image = defaultPhoto, imagePosition = 'center 8%' } = Astro.props;
const trail: Crumb[] = [{ label: 'Home', href: paths.home }, ...crumbs];
---

<header class="banner">
  <div class="banner__bg" aria-hidden="true">
    <Image
      class="banner__img"
      src={image}
      alt=""
      widths={[640, 960, 1440, 1920]}
      sizes="100vw"
      priority
      style={`object-position: ${imagePosition}`}
    />
    <span class="banner__tint"></span>
    <span class="banner__overlay"></span>
    <img class="banner__watermark" src={watermark.src} width={watermark.width} height={watermark.height} alt="" />
  </div>

  <h1 class="t-h1 banner__title" data-banner-title>{title}</h1>
  <nav class="banner__crumbs" aria-label="Breadcrumb">
    <ol>
      {
        trail.map((crumb, i) =>
          i < trail.length - 1 && crumb.href ? (
            <li>
              <a href={crumb.href}>{crumb.label}</a>
              <span aria-hidden="true"> /</span>
            </li>
          ) : i < trail.length - 1 ? (
            <li>
              {crumb.label}
              <span aria-hidden="true"> /</span>
            </li>
          ) : (
            <li aria-current="page" data-banner-current>
              {crumb.label}
            </li>
          ),
        )
      }
    </ol>
  </nav>
</header>

<style>
  .banner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-12);
    min-height: var(--layout-banner-height);
    padding: var(--layout-banner-padding-top) var(--layout-page-padding) var(--space-40);
    overflow: hidden;
    isolation: isolate;
    background: var(--bg-dark);
    color: var(--text-on-dark);
    text-align: center;
  }

  .banner__bg,
  .banner__tint,
  .banner__overlay {
    position: absolute;
    inset: 0;
  }
  .banner__bg {
    z-index: -1;
  }
  .banner__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: banner-settle 800ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .banner__tint {
    background: var(--banner-tint);
    mix-blend-mode: soft-light;
  }
  .banner__overlay {
    background: var(--banner-overlay);
  }
  .banner__watermark {
    position: absolute;
    top: var(--space-64);
    right: calc(-1 * var(--space-64));
    width: var(--size-banner-watermark);
    height: auto;
  }

  .banner__title,
  .banner__crumbs {
    animation: banner-rise 800ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .banner__crumbs {
    animation-delay: 120ms;
  }

  .banner__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .banner__crumbs a {
    color: var(--text-on-dark);
    text-decoration: none;
  }
  .banner__crumbs a:hover {
    text-decoration: underline;
  }
  .banner__crumbs a:focus-visible {
    outline-color: var(--text-on-dark);
  }
  .banner__crumbs [aria-current='page'] {
    color: var(--text-highlight);
  }

  @keyframes banner-settle {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1);
    }
  }
  @keyframes banner-rise {
    from {
      opacity: 0;
      transform: translateY(var(--space-24));
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
